@page "/aporte-cajero/details"
@attribute [Authorize(Roles = "Cajero")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Detalles del Aporte - Cajero</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-teal text-white">
            <h4 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i> Detalles del Aporte</h4>
        </div>
        <div class="card-body">
            @if (aporte == null)
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i> Aporte no encontrado.
                </div>
                <div class="text-center mt-3">
                    <a href="/aporte-cajero" class="btn btn-teal">
                        <i class="bi bi-arrow-left me-1"></i> Volver al historial
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <!-- Datos del Socio -->
                    <div class="col-md-6">
                        <h5 class="text-muted mb-3"><i class="bi bi-person me-2"></i> Socio</h5>
                        <div class="mb-2"><strong>Nombre:</strong> @aporte.Socio?.Nombre @aporte.Socio?.Apellido</div>
                        <div class="mb-2"><strong>Cédula:</strong> @aporte.Socio?.Cedula</div>
                        <div class="mb-2"><strong>Teléfono:</strong> @aporte.Socio?.Telefono</div>
                        <div class="mb-2"><strong>Email:</strong> @aporte.Socio?.Email</div>
                    </div>

                    <!-- Datos del Aporte -->
                    <div class="col-md-6">
                        <h5 class="text-muted mb-3"><i class="bi bi-receipt me-2"></i> Información del Aporte</h5>
                        <div class="mb-2"><strong>Fecha:</strong> @aporte.Fecha.ToString("dd/MM/yyyy")</div>
                        <div class="mb-2"><strong>Monto:</strong> <span class="fw-bold text-success">@aporte.Monto.ToString("C", new System.Globalization.CultureInfo("es-DO"))</span></div>
                        <div class="mb-2">
                            <strong>Tipo:</strong>
                            @if (aporte.Tipo == "Extraordinario")
                            {
                                <span class="badge bg-warning text-dark">Extraordinario</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Ordinario</span>
                            }
                        </div>
                        <div class="mb-2"><strong>Concepto:</strong> @(aporte.Concepto ?? "Sin concepto")</div>
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <a href="/aporte-cajero" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver al historial
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card-header.bg-teal {
        background: linear-gradient(135deg, #00796b, #009688);
    }

    .btn-teal {
        background: linear-gradient(135deg, #00796b, #009688);
        color: white;
        border: none;
    }

        .btn-teal:hover {
            opacity: 0.9;
        }
</style>

@code {
    private Aporte aporte;
    private int aporteId;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("id", out var idValues))
        {
            if (int.TryParse(idValues.FirstOrDefault(), out aporteId))
            {
                using var context = DbFactory.CreateDbContext();
                aporte = await context.Aportes
                    .Include(a => a.Socio)
                    .FirstOrDefaultAsync(a => a.Id == aporteId);
            }
        }
    }
}