@page "/aportes"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Prototipo - Gestión de Aportes</PageTitle>

<div class="container-fluid mt-4">
    <RadzenStack Gap="1.5rem">
        
        @* Encabezado Dinámico *@
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="account_balance" Size="36px" Style="color: var(--rz-success)" />
                    <div>
                        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Gestión de Aportes</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">Prototipo v1.0 - Registro histórico de transacciones</RadzenText>
                    </div>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" Class="rz-text-align-right">
                <RadzenButton Text="Registrar Nuevo Aporte" Icon="add_circle" ButtonStyle="ButtonStyle.Success" 
                              Size="ButtonSize.Large" Click="@(() => NavigationManager.NavigateTo("/aportes/create"))" />
            </RadzenColumn>
        </RadzenRow>

        @* Tarjetas de Resumen Rápido (Ideales para prototipos) *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Flat" Class="rz-background-color-success-lighter rz-p-4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="payments" Style="color: var(--rz-success)" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Total Recaudado</RadzenText>
                            <RadzenText TextStyle="TextStyle.H5"><b>RD$ @allAportes.Sum(a => a.Monto).ToString("N2")</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Flat" Class="rz-background-color-info-lighter rz-p-4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="event" Style="color: var(--rz-info)" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Aportes del Mes</RadzenText>
                            <RadzenText TextStyle="TextStyle.H5"><b>@allAportes.Count(a => a.Fecha.Month == DateTime.Today.Month)</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* Tabla Principal con RadzenDataGrid *@
        <RadzenCard Class="rz-shadow-4">
            <RadzenDataGrid @ref="grid" Data="@allAportes" TItem="Aporte" 
                            AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            AllowPaging="true" PageSize="10" AllowSorting="true" 
                            PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                            EmptyText="No se encontraron registros de aportes.">
                <Columns>
                    @* Columna Socio (Búsqueda por nombre) *@
                    <RadzenDataGridColumn TItem="Aporte" Title="Socio" SortProperty="Socio.Nombre" FilterProperty="Socio.Nombre">
                        <Template Context="a">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenAvatar Text="@($"{a.Socio?.Nombre?[0]}{a.Socio?.Apellido?[0]}")" Size="AvatarSize.ExtraSmall" />
                                <RadzenText TextStyle="TextStyle.Body2"><b>@a.Socio?.Nombre @a.Socio?.Apellido</b></RadzenText>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Aporte" Property="Fecha" Title="Fecha" FormatString="{0:dd/MM/yyyy}" Width="150px" />
                    
                    <RadzenDataGridColumn TItem="Aporte" Property="Tipo" Title="Tipo">
                        <Template Context="a">
                            <RadzenBadge Text="@a.Tipo" BadgeStyle="@(a.Tipo == "Extraordinario" ? BadgeStyle.Info : BadgeStyle.Secondary)" IsPill="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Aporte" Property="Monto" Title="Monto">
                        <Template Context="a">
                            <span class="rz-color-success" style="font-weight: bold;">RD$ @a.Monto.ToString("N2")</span>
                        </Template>
                    </RadzenDataGridColumn>

                    @* Acciones *@
                    <RadzenDataGridColumn TItem="Aporte" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="140px">
                        <Template Context="a">
                            <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.Medium" 
                                          Click="@(() => NavigationManager.NavigateTo($"/aportes/details?id={a.Id}"))" />
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" 
                                          Click="@(() => NavigationManager.NavigateTo($"/aportes/edit?id={a.Id}"))" Class="rz-mx-1" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" 
                                          Click="@(() => NavigationManager.NavigateTo($"/aportes/delete?id={a.Id}"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

    </RadzenStack>
</div>

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    RadzenDataGrid<Aporte> grid = default!;
    private List<Aporte> allAportes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var context = DbFactory.CreateDbContext();
        allAportes = await context.Aportes
            .Include(a => a.Socio)
            .OrderByDescending(a => a.Fecha)
            .ToListAsync();
    }
}