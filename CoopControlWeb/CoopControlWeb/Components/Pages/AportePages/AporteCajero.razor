@page "/aporte-cajero"
@attribute [Authorize(Roles = "Cajero")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory

<PageTitle>Aportes - Cajero</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-hand-index-thumb me-2"></i> Historial de Aportes</h3>
    <a class="btn btn-success btn-sm" href="/aporte-cajero/create">
        <i class="bi bi-plus-circle me-1"></i> Registrar Aporte
    </a>
</div>

@if (aportes.Count == 0)
{
    <div class="alert alert-info text-center">
        <i class="bi bi-inbox me-2"></i> No hay aportes registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-success">
                <tr>
                    <th>Socio</th>
                    <th>Cédula</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Tipo</th>
                    <th>Concepto</th>
                    <th>Detalles</th> <!-- ✅ Nueva columna -->
                </tr>
            </thead>
            <tbody>
                @foreach (var aporte in aportes.OrderByDescending(a => a.Fecha))
                {
                    <tr>
                        <td>@aporte.Socio?.Nombre @aporte.Socio?.Apellido</td>
                        <td>@aporte.Socio?.Cedula</td>
                        <td>@aporte.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@aporte.Monto.ToString("C", new System.Globalization.CultureInfo("es-DO"))</td>
                        <td>
                            @if (aporte.Tipo == "Extraordinario")
                            {
                                <span class="badge bg-warning text-dark">Extraordinario</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Ordinario</span>
                            }
                        </td>
                        <td>@(aporte.Concepto ?? "-")</td>
                        <!-- ✅ Botón de ver detalles -->
                        <td>
                            <a href="@($"/aporte-cajero/details?id={aporte.Id}")" class="btn btn-sm btn-info">
                                <i class="bi bi-eye me-1"></i> Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Aporte> aportes = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        aportes = await context.Aportes
            .Include(a => a.Socio)
            .ToListAsync();
    }
}
}