@page "/aporte-cajero/create"
@attribute [Authorize(Roles = "Cajero")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Registrar Aporte - Cajero</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-teal text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i> Registrar Nuevo Aporte</h4>
        </div>
        <div class="card-body">
            <EditForm Model="Aporte" OnValidSubmit="AddAporte" FormName="create">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="socio" class="form-label fw-semibold">Socio</label>
                        <InputSelect id="socio" @bind-Value="Aporte.SocioId" class="form-select" aria-required="true">
                            <option value="">Seleccione un socio</option>
                            @foreach (var socio in socios)
                            {
                                <option value="@socio.Id">@socio.Nombre @socio.Apellido (@socio.Cedula)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Aporte.SocioId" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label for="fecha" class="form-label fw-semibold">Fecha</label>
                        <InputDate id="fecha" @bind-Value="Aporte.Fecha" class="form-control" aria-required="true" />
                        <ValidationMessage For="() => Aporte.Fecha" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label for="monto" class="form-label fw-semibold">Monto (RD$)</label>
                        <InputNumber id="monto" @bind-Value="Aporte.Monto" class="form-control" aria-required="true" min="1" />
                        <ValidationMessage For="() => Aporte.Monto" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label for="concepto" class="form-label fw-semibold">Concepto</label>
                        <InputText id="concepto" @bind-Value="Aporte.Concepto" class="form-control" placeholder="Ej: Aporte mensual, donación..." />
                        <ValidationMessage For="() => Aporte.Concepto" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label for="tipo" class="form-label fw-semibold">Tipo de Aporte</label>
                        <InputSelect id="tipo" @bind-Value="Aporte.Tipo" class="form-select" aria-required="true">
                            <option value="">Seleccionar tipo</option>
                            <option value="Ordinario">Ordinario</option>
                            <option value="Extraordinario">Extraordinario</option>
                        </InputSelect>
                        <ValidationMessage For="() => Aporte.Tipo" class="text-danger" />
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a href="/aporte-cajero" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver al historial
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Registrar Aporte
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .card-header.bg-teal {
        background: linear-gradient(135deg, #00796b, #009688);
    }
</style>

@code {
    [SupplyParameterFromForm]
    private Aporte Aporte { get; set; } = new();

    private List<Socios> socios = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // ✅ Sin .Where(s => s.Estado) → evita el error CS1061
        socios = await context.Socios
            .OrderBy(s => s.Nombre)
            .ToListAsync();

        Aporte.Fecha = DateTime.Today;
    }

    private async Task AddAporte()
    {
        using var context = DbFactory.CreateDbContext();
        context.Aportes.Add(Aporte);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/aporte-cajero");
    }
}