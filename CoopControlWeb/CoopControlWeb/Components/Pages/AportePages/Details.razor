@page "/aportes/details"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Prototipo - Detalle de Aporte</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeLG="10">

            @if (aporte == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Recuperando comprobante...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                    @* Barra superior (Verde para detalles de ingresos) *@
                    <div style="background-color: var(--rz-success); height: 10px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">

                        @* Cabecera Estilo Recibo *@
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-8">
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Detalle de Aporte</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption">Referencia de Transacción: #@aporte.Id</RadzenText>
                            </RadzenStack>
                            <RadzenBadge Text="Procesado" BadgeStyle="BadgeStyle.Success" IsPill="true" Style="padding: 10px 20px; font-size: 1rem;" />
                        </RadzenStack>

                        <RadzenRow Gap="2rem">
                            @* Columna Izquierda: Información de la Transacción *@
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1.5rem">
                                    <div class="rz-display-flex rz-align-items-center">
                                        <RadzenIcon Icon="person" Class="rz-me-2" Style="color: var(--rz-primary)" />
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>Información del Socio</b></RadzenText>
                                    </div>

                                    <RadzenFormField Text="Nombre del Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@($"{aporte.Socio?.Nombre} {aporte.Socio?.Apellido}")" ReadOnly="true" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Cédula" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@aporte.Socio?.Cedula" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            @* Columna Derecha: Detalles Financieros *@
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1.5rem">
                                    <div class="rz-display-flex rz-align-items-center">
                                        <RadzenIcon Icon="account_balance_wallet" Class="rz-me-2" Style="color: var(--rz-success)" />
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>Datos Financieros</b></RadzenText>
                                    </div>

                                    <RadzenFormField Text="Monto Percibido" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@($"RD$ {aporte.Monto:N2}")" ReadOnly="true" Style="font-weight: bold; color: var(--rz-success);" />
                                    </RadzenFormField>

                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Fecha" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenTextBox Value="@aporte.Fecha.ToString("dd/MM/yyyy")" ReadOnly="true" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Tipo" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenTextBox Value="@aporte.Tipo" ReadOnly="true" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        @* Sección Experimental: Resumen de Acumulados *@
                        <div class="rz-mt-10 rz-p-6 rz-border-radius-1" style="background-color: var(--rz-grid-stripe-background-color);">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0">Total Acumulado por este Socio:</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0" Style="color: var(--rz-primary-darker)"><b>RD$ @totalAportes.ToString("N2")</b></RadzenText>
                            </RadzenStack>
                        </div>

                        @* Acciones Inferiores *@
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-10 rz-pt-4" Style="border-top: 1px solid var(--rz-divider);">
                            <RadzenButton Text="Regresar" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                          Click="@(() => NavigationManager.NavigateTo("/aportes"))" />

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="Editar" Icon="edit" ButtonStyle="ButtonStyle.Warning"
                                              Click="@(() => NavigationManager.NavigateTo($"/aportes/edit?id={aporte.Id}"))" Style="color: black;" />
                                <RadzenButton Text="Imprimir Comprobante" Icon="print" ButtonStyle="ButtonStyle.Secondary" />
                            </RadzenStack>
                        </RadzenStack>

                    </div>
                </RadzenCard>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Aporte? aporte;
    private decimal totalAportes = 0;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        aporte = await context.Aportes
            .Include(a => a.Socio)
            .FirstOrDefaultAsync(a => a.Id == Id);

        if (aporte == null)
        {
            NavigationManager.NavigateTo("/aportes");
            return;
        }

        // Cálculo experimental para el prototipo
        totalAportes = await context.Aportes
            .Where(a => a.SocioId == aporte.SocioId)
            .SumAsync(a => a.Monto);
    }
}