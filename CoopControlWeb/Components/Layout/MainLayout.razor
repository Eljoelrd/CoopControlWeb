@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="width: 100%;">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="CoopControl Web" Class="ms-3" Style="font-weight: 600; font-size: 1.25rem; color: #f0fff4;" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-left: auto; padding-right: 1rem;">
                <RadzenAppearanceToggle Class="header-btn" />

                <AuthorizeView>
                    <Authorized>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: white; margin-bottom: 0;" Class="rz-display-none rz-display-md-block">
                            @context.User.Identity?.Name (@userRole)
                        </RadzenText>
                        <RadzenButton Icon="logout" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                      Click="@(() => NavigationManager.NavigateTo("/logout", true))" />
                    </Authorized>
                </AuthorizeView>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <AuthorizeView>
                <NotAuthorized>
                    <RadzenPanelMenuItem Text="Inicio" Icon="home" Path="/" />
                    <RadzenPanelMenuItem Text="Iniciar Sesión" Icon="login" Path="/login" />
                    <RadzenPanelMenuItem Text="Registrarse" Icon="person_add" Path="/register" />
                </NotAuthorized>

                <Authorized>
                    <RadzenPanelMenuItem Text="Inicio" Icon="home" Path="/" />

                    @* Usamos la variable userRole que cargamos en OnParametersSet *@
                    @if (userRole == "Admin")
                    {
                        <!-- Menú Administrador -->
                        <RadzenPanelMenuItem Text="Gestión de Socios" Icon="people" Path="/socios" />
                        <RadzenPanelMenuItem Text="Gestión de Aportes" Icon="payments" Path="/aportes" />
                        <RadzenPanelMenuItem Text="Gestión de Préstamos" Icon="account_balance" Path="/prestamos" />
                        <RadzenPanelMenuItem Text="Certificados" Icon="description" Path="/certificados" />
                        <RadzenPanelMenuItem Text="Depósitos" Icon="savings" Path="/depositos" />
                        <RadzenPanelMenuItem Text="Retiros" Icon="payments" Path="/retiros" />
                        <RadzenPanelMenuItem Text="Reportes" Icon="assessment" Path="/reportes" />
                        <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuracion" />
                    }
                    else if (userRole == "Cajero")
                    {
                        <!-- Menú Cajero -->
                        <RadzenPanelMenuItem Text="Aportes" Icon="attach_money" Path="/aporte-cajero" />
                        <RadzenPanelMenuItem Text="Préstamos" Icon="" Path="/prestamo-cajero" />
                        <RadzenPanelMenuItem Text="Certificados" Icon="description" Path="/certificados" />
                        <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuracion" />
                    }
                    else if (userRole == "Socio")
                    {
                        <!-- Menú Socio (DefaultUser) -->
                        <RadzenPanelMenuItem Text="Mis Aportes" Icon="attach_money" Path="/mis-aportes" />
                        <RadzenPanelMenuItem Text="Mis Préstamos" Icon="credit_card" Path="/mis-prestamos" />
                        <RadzenPanelMenuItem Text="Mis Certificados" Icon="description" Path="/mis-certificados" />
                        <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuracion" />
                    }
                </Authorized>
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
            <span>© 2026 CoopControl Web</span>
            <RadzenText TextStyle="TextStyle.Caption">Versión 1.0.0 (Prototipo)</RadzenText>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private string userRole = "";

    // Este es el "motor" que hace que el menú cambie al loguearte
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Extraemos el rol directamente de los Claims para máxima velocidad
            userRole = user.FindFirst(c => c.Type == ClaimTypes.Role)?.Value ?? "";
        }
        else
        {
            userRole = "";
        }
    }
}



