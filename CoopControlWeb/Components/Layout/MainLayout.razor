@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IDbContextFactory<AppDBContext> DbFactory
@rendermode InteractiveServer

<RadzenLayout Style="grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body' 'rz-footer rz-footer'; grid-template-columns: auto 1fr; grid-template-rows: auto 1fr auto; height: 100vh;">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="width: 100%;">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="CoopControl Web" Class="ms-3" Style="font-weight: 600; font-size: 1.25rem; color: #f0fff4;" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-left: auto; padding-right: 1rem;">
                <RadzenAppearanceToggle />
                <AuthorizeView>
                    <Authorized>
                        <RadzenLink Path="perfil" Style="text-decoration: none;" Class="rz-display-none rz-display-md-block user-profile-chip">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="account_circle" Style="font-size: 2rem; color: white;" />
                                <RadzenStack Gap="0" AlignItems="AlignItems.Start">
                                    <RadzenText Text="@fullName" Style="color: white; font-weight: 600; line-height: 1.1; margin: 0;" />
                                    <RadzenText Text="@userRole" TextStyle="TextStyle.Caption" Style="color: rgba(255,255,255,0.8); line-height: 1; margin: 0;" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenLink>
                        <RadzenButton Icon="logout" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                      Click="@(() => NavigationManager.NavigateTo("/logout", true))" />
                    </Authorized>
                </AuthorizeView>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <RadzenPanelMenuItem Text="Inicio" Icon="home" Path="/" />

            <AuthorizeView>
                <NotAuthorized>
                    <RadzenPanelMenuItem Text="Iniciar Sesión" Icon="login" Path="/login" />
                    <RadzenPanelMenuItem Text="Registrarse" Icon="person_add" Path="/register" />
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Cajero">
                <Authorized>
                    @* --- SECCIÓN ADMINISTRATIVA --- *@
                    <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/dashboard" />
                    <RadzenPanelMenuItem Text="Gestión de Socios" Icon="people" Path="/socios" />
                    <RadzenPanelMenuItem Text="Caja / Transacciones" Icon="receipt_long">
                        <RadzenPanelMenuItem Text="Gestión de Depósitos" Icon="savings" Path="/depositos" />
                    </RadzenPanelMenuItem>

                    <RadzenPanelMenuItem Text="Servicios de Ahorro" Icon="account_balance">
                        <RadzenPanelMenuItem Text="Aportaciones" Icon="payments" Path="/aportes" />
                        <RadzenPanelMenuItem Text="Ahorros Retirables" Icon="account_balance_wallet" Path="/ahorros/transferir-retirable" />
                        <RadzenPanelMenuItem Text="Certificados (Plazo Fijo)" Icon="description" Path="/certificados" />
                    </RadzenPanelMenuItem>

                    <RadzenPanelMenuItem Text="Cartera de Créditos" Icon="credit_score">
                        <RadzenPanelMenuItem Text="Préstamos" Icon="format_list_bulleted" Path="/prestamos" />
                        <RadzenPanelMenuItem Text="Solicitudes Nuevas" Icon="add_task" Path="/prestamos/solicitudes" />
                    </RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Reportes" Icon="assessment" Path="/reportes" />
                    <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuraciones" />
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Socio">
                <Authorized>
                    @* --- SECCIÓN EXCLUSIVA SOCIO --- *@
                    <RadzenPanelMenuItem Text="Mi Cooperativa" Icon="person" Expanded="true">
                        <RadzenPanelMenuItem Text="Estado de Cuenta" Icon="analytics" Path="/mi-estado" />
                        <RadzenPanelMenuItem Text="Mis Aportes" Icon="history" Path="/mis-aportes" />
                        <RadzenPanelMenuItem Text="Mis Préstamos" Icon="assignment" Path="/mis-prestamos" />
                    </RadzenPanelMenuItem>

                    <RadzenPanelMenuItem Text="Solicitudes" Icon="edit_note">
                        <RadzenPanelMenuItem Text="Solicitar Préstamo" Icon="add_moderator" Path="/prestamos/solicitar" />
                        <RadzenPanelMenuItem Text="Simulador de Cuotas" Icon="calculate" Path="/calculadora" />
                    </RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuraciones" />
                </Authorized>
            </AuthorizeView>
            
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4 rz-p-md-8">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-px-4">
            <RadzenText TextStyle="TextStyle.Caption">© 2026 CoopControl Web </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption"><b>Estado:</b> @(string.IsNullOrEmpty(userRole) ? "Invitado" : $"Conectado como {userRole}")</RadzenText>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private string userRole = "Invitado";
    private string fullName = "Usuario";

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "Socio";

            var email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name;
            if (!string.IsNullOrEmpty(email))
            {
                using var ctx = await DbFactory.CreateDbContextAsync();
                var dbUser = await ctx.Users.FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());
                if (dbUser != null)
                {
                    fullName = $"{dbUser.Nombre} {dbUser.Apellido}";
                }
            }
        }
    }
}