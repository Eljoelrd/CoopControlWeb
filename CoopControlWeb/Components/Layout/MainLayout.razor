@inherits LayoutComponentBase
@rendermode InteractiveServer

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="width: 100%;">
            <!-- Lado izquierdo -->
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="CoopControl Web" Class="ms-3" Style="font-weight: 600; font-size: 1.25rem; color: #f0fff4;" />

            <!-- Lado derecho -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-left: auto;">
                <RadzenButton Icon="search" Class="header-btn" @onclick="OnSearch" title="Buscar" />

                <RadzenButton Icon="notifications" Class="header-btn" @onclick="OnNotifications" title="Notificaciones">
                    @if (unreadNotifications > 0)
                    {
                        <span class="notification-badge">@unreadNotifications</span>
                    }
                </RadzenButton>

                <RadzenAppearanceToggle Class="header-btn" />

                <RadzenButton Icon="account_circle" Class="header-btn" @onclick="OnProfile" title="Perfil" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Responsive="false" Style="width: max-content">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <RadzenPanelMenuItem Text="Inicio" Icon="home" Path="/" />
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/dashboard" />
            <RadzenPanelMenuItem Text="Cooperativas" Icon="account_balance" Path="/cooperativas" />
            <RadzenPanelMenuItem Text="Socios" Icon="people" Path="/socios" />
            <RadzenPanelMenuItem Text="Componente de Prueba" Icon="grid_on" Path="/componenteprueba" />

            <RadzenPanelMenuItem Text="Fundamentos UI" Icon="auto_awesome">
                <RadzenPanelMenuItem Text="Temas" Icon="color_lens" Path="/temas" />
                <RadzenPanelMenuItem Text="Colores" Icon="invert_colors" Path="/colores" />
                <RadzenPanelMenuItem Text="Tipografía" Icon="text_fields" Path="/tipografia" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Reportes" Icon="assessment" Path="/reportes" />
            <RadzenPanelMenuItem Text="Configuración" Icon="settings" Path="/configuracion" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
            <span>© 2026 CoopControl Web</span>
            <span>Versión 1.0.0</span>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private int unreadNotifications = 3;

    private void OnSearch()
    {
        // Lógica de búsqueda
    }

    private void OnNotifications()
    {
        // Lógica de notificaciones
        unreadNotifications = 0;
    }

    private void OnProfile()
    {
        // Lógica de perfil
    }
}
