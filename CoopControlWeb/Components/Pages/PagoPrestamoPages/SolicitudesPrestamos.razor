@page "/prestamos/solicitudes"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, Cajero")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Solicitudes de Préstamos</PageTitle>

<RadzenStack Gap="1rem" Class="rz-p-6">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText TextStyle="TextStyle.H4" Class="rz-m-0">Bandeja de Solicitudes</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">Evaluación y aprobación de nuevos créditos</RadzenText>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid Data="@solicitudes" TItem="Prestamo" AllowPaging="true" PageSize="10" AllowSorting="true" Responsive="true">
        <Columns>
            <RadzenDataGridColumn TItem="Prestamo" Property="Socio.Nombre" Title="Socio">
                <Template Context="p">
                    @p.Socio?.Nombre @p.Socio?.Apellido
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Prestamo" Property="Monto" Title="Monto">
                <Template Context="p">
                    <b>RD$ @p.Monto.ToString("N2")</b>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Prestamo" Property="FechaPrestamo" Title="Fecha Solicitud" FormatString="{0:dd/MM/yyyy}" />
            <RadzenDataGridColumn TItem="Prestamo" Title="Estado" TextAlign="TextAlign.Center">
                <Template Context="p">
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@p.Estado" Variant="Variant.Flat" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Prestamo" Title="Acciones" TextAlign="TextAlign.Center" Width="200px">
                <Template Context="p">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                        <RadzenButton Icon="check_circle" ButtonStyle="ButtonStyle.Success" Tooltip="Aprobar"
                                      Click="@(() => ProcesarSolicitud(p, "Aprobado"))" Size="ButtonSize.Small" />
                        <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Tooltip="Rechazar"
                                      Click="@(() => ProcesarSolicitud(p, "Rechazado"))" Size="ButtonSize.Small" />
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Tooltip="Ver Detalles"
                                      Click="@(() => NavigationManager.NavigateTo($"/prestamos/edit?id={p.Id}"))" Size="ButtonSize.Small" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private List<Prestamo> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        using var context = DbFactory.CreateDbContext();
        solicitudes = await context.Prestamos
            .Include(p => p.Socio)
            .Where(p => p.Estado == "Pendiente")
            .OrderByDescending(p => p.FechaPrestamo)
            .ToListAsync();
    }

    private async Task ProcesarSolicitud(Prestamo prestamo, string nuevoEstado)
    {
        using var context = DbFactory.CreateDbContext();
        var p = await context.Prestamos.FindAsync(prestamo.Id);
        if (p != null)
        {
            p.Estado = nuevoEstado;
            await context.SaveChangesAsync();
            await CargarSolicitudes();
        }
    }
}