@page "/calculadora"
@using CoopControlWeb.Modelos
@inject NavigationManager NavigationManager

<PageTitle>Calculadora de Préstamos - CoopControl Web</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
            <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                <div style="background-color: var(--rz-primary); height: 10px; width: 100%;"></div>
                
                <div class="rz-p-6 rz-p-md-10">
                    <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="calculate" Style="color: var(--rz-primary); font-size: 2rem;" />
                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Calculadora de Cuotas</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Estime sus cuotas mensuales según el tipo de préstamo y el plazo deseado.</RadzenText>
                    </RadzenStack>

                    <RadzenStack Gap="1.5rem">
                        <RadzenFormField Text="Tipo de Préstamo" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="simulacion.TipoPrestamo" Data="@(new[] { "Personal", "Comercial", "Vivienda" })" Change="@ActualizarTasa" />
                        </RadzenFormField>

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Monto (RD$)" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenNumeric @bind-Value="simulacion.Monto" TValue="decimal" Format="N2" Change="@(() => StateHasChanged())" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Plazo (Meses)" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenNumeric @bind-Value="simulacion.PlazoMeses" TValue="int?" Min="1" Change="@(() => StateHasChanged())" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenAlert Title="Simulación de Cuotas" AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="true">
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Cuota Mensual</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5"><b>RD$ @(simulacion.CuotaMensual?.ToString("N2") ?? "0.00")</b></RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Tasa Aplicada</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H6">@simulacion.TasaInteres% anual</RadzenText>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenAlert>

                        <RadzenButton Text="Solicitar este Préstamo" Icon="assignment" ButtonStyle="ButtonStyle.Primary" 
                                      Click="@IrASolicitud" Class="rz-mt-4" Style="border-radius: 25px;" />
                    </RadzenStack>
                </div>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Prestamo simulacion = new() { Monto = 50000, PlazoMeses = 12, TasaInteres = 12m, TipoPrestamo = "Personal" };

    private void ActualizarTasa()
    {
        simulacion.TasaInteres = simulacion.TipoPrestamo switch
        {
            "Vivienda" => 8.5m,
            "Comercial" => 10.0m,
            _ => 12.0m
        };
    }

    private void IrASolicitud()
    {
        NavigationManager.NavigateTo($"/prestamos/solicitar?monto={simulacion.Monto}&plazo={simulacion.PlazoMeses}&tipo={simulacion.TipoPrestamo}");
    }
}