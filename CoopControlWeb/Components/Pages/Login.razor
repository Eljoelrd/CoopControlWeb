@page "/login"
@using CoopControlWeb.Components.Middleware
@using CoopControlWeb.Modelos
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication.Cookies
@inject UserService userService
@inject NavigationManager nav

<PageTitle>Inicio de Sesión - CoopControl Web</PageTitle>

<div class="login-container">
    <div class="login-wrapper">
        <!-- Panel Izquierdo con Gradiente -->
        <div class="login-welcome-panel">
            <div class="welcome-content">
                <h1 class="welcome-title">¡Bienvenido!</h1>
                <p class="welcome-subtitle">Únete a la comunidad más grande</p>
                <p class="welcome-description">Comencemos con tu prueba de <strong>30 días</strong>.</p>
            </div>
        </div>

        <!-- Panel Derecho con Formulario -->
        <div class="login-form-panel">
            <div class="form-wrapper">
                <h2 class="login-heading">Iniciar Sesión</h2>

                <RadzenTemplateForm TItem="InputModel" Data="@Input" Submit="@OnLogin">
                    <RadzenStack Gap="1.5rem">
                        <div class="form-group">
                            <label class="form-label">Usuario</label>
                            <RadzenTextBox @bind-Value="Input.Email" 
                                          Name="Email" 
                                          Class="form-input"
                                          Placeholder="Ingresa tu correo electrónico" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Contraseña</label>
                            <RadzenPassword @bind-Value="Input.Password" 
                                           Name="Password" 
                                           Class="form-input"
                                           Placeholder="Ingresa tu contraseña" />
                        </div>

                        <RadzenButton ButtonType="ButtonType.Submit" 
                                      Text="Iniciar Sesión"
                                      ButtonStyle="ButtonStyle.Primary" 
                                      Class="login-button" />

                        @if (errorMessage != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" 
                                        Variant="Variant.Flat" 
                                        Shade="Shade.Lighter"
                                        Class="error-alert">
                                @errorMessage
                            </RadzenAlert>
                        }
                    </RadzenStack>
                </RadzenTemplateForm>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private InputModel Input = new();

    public class InputModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public async Task OnLogin()
    {
        var user = userService.Verify(Input.Email, Input.Password);
        if (user == null)
        {
            errorMessage = "Credenciales inválidas o cuenta inactiva.";
            return;
        }

        var claims = new List<Claim> {
            new Claim(ClaimTypes.Name, user.Email),
            new Claim(ClaimTypes.Role, user.Role)
        };

        var claimIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        ClaimsPrincipal claimsPrincipal = new ClaimsPrincipal(claimIdentity);
        Guid key = Guid.NewGuid();
        AuthMiddleware.Logins[key] = claimsPrincipal;

        nav.NavigateTo($"/login?key={key}", forceLoad: true);
    }
}

<style>
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background-color: #f5f5f5;
        padding: 20px;
    }

    .login-wrapper {
        display: flex;
        width: 100%;
        max-width: 900px;
        background-color: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    /* Panel Izquierdo */
    .login-welcome-panel {
        flex: 1;
        background: linear-gradient(135deg, #d485d9 0%, #a8d8f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        color: white;
        text-align: center;
        min-height: 500px;
    }

    .welcome-content {
        max-width: 300px;
    }

    .welcome-title {
        font-size: 48px;
        font-weight: 300;
        margin: 0 0 20px 0;
        letter-spacing: 1px;
    }

    .welcome-subtitle {
        font-size: 18px;
        font-weight: 500;
        margin: 0 0 10px 0;
        opacity: 0.95;
    }

    .welcome-description {
        font-size: 16px;
        font-weight: 400;
        margin: 0;
        opacity: 0.9;
    }

    /* Panel Derecho */
    .login-form-panel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

    .form-wrapper {
        width: 100%;
        max-width: 350px;
    }

    .login-heading {
        font-size: 28px;
        font-weight: 600;
        color: #333;
        margin: 0 0 30px 0;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 16px;
        font-weight: 500;
        color: #333;
        margin-bottom: 8px;
    }

    .form-input {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.3s ease;
    }

    .form-input:focus {
        border-color: #1e88e5;
        outline: none;
    }

    .login-button {
        width: 100%;
        padding: 12px 24px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 25px;
        background: linear-gradient(90deg, #1e88e5 0%, #1565c0 100%);
        border: none;
        color: white;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 48px;
    }

    .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(30, 136, 229, 0.4);
    }

    .error-alert {
        margin-top: 10px;
    }

    /* Responsive */
    @@media screen and (max-width: 768px) {
        .login-wrapper {
            flex-direction: column;
        }

        .login-welcome-panel {
            min-height: 300px;
            padding: 30px;
        }

        .welcome-title {
            font-size: 36px;
        }

        .login-form-panel {
            padding: 30px;
        }
    }
</style>