@page "/login"
@using CoopControlWeb.Components.Middleware
@using CoopControlWeb.Modelos
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication.Cookies
@inject UserService userService
@inject NavigationManager nav

<PageTitle>Inicio de Sesión - CoopControl Web</PageTitle>

<div class="rz-p-0 rz-p-md-12 d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <RadzenRow Gap="0" class="rz-mx-auto rz-border-radius-6 rz-shadow-10" Style="width: 100%; max-width: 900px; overflow: hidden; background-color: var(--rz-panel-background-color);">

        @* Columna Izquierda: Bienvenida y Visual *@
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard class="rz-shadow-0 rz-border-radius-0 rz-p-12 d-flex flex-column justify-content-center align-items-center rz-text-align-center"
                        Style="height: 100%; min-height: 400px; background: var(--rz-primary) no-repeat center center; background-size: cover; background-image: url('data:image/svg+xml;base64,')">
                <RadzenImage Path="CoopControlWeb_logo.png" Style="width: 140px; margin-bottom: 20px; filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.2));" />
                <RadzenText TextStyle="TextStyle.DisplayH4" TagName="TagName.H2" class="rz-color-white rz-mb-2" Style="font-weight: 800;">CoopControl</RadzenText>
                <RadzenText TextStyle="TextStyle.H6" class="rz-color-white rz-mb-6" Style="opacity: 0.9;">Gestión Cooperativa Inteligente</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-color-white" Style="max-width: 250px;">Bienvenido al sistema. Acceda para gestionar sus aportes y préstamos.</RadzenText>
            </RadzenCard>
        </RadzenColumn>

        @* Columna Derecha: Formulario *@
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard class="rz-shadow-0 rz-border-radius-0 rz-p-8 rz-p-md-12">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" class="rz-mb-2" Style="font-weight: 700;">Iniciar Sesión</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary rz-mb-8">Por favor, ingrese sus credenciales.</RadzenText>

                <RadzenTemplateForm TItem="InputModel" Data="@Input" Submit="@OnLogin">
                    <RadzenStack Gap="1.5rem">
                        <RadzenFormField Text="Correo Electrónico" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="email" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="Input.Email" Name="Email" style="width: 100%;" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenFormField Text="Contraseña" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="lock" />
                            </Start>
                            <ChildContent>
                                <RadzenPassword @bind-Value="Input.Password" Name="Password" style="width: 100%;" />
                            </ChildContent>
                        </RadzenFormField>

                        @if (errorMessage != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small">
                                @errorMessage
                            </RadzenAlert>
                        }

                        <RadzenButton ButtonType="ButtonType.Submit" Text="Entrar al Sistema"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                      Style="border-radius: 25px; height: 50px; margin-top: 1rem;" />
                    </RadzenStack>
                </RadzenTemplateForm>

                <div class="rz-mt-12 rz-text-align-center">
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                        © 2026 CoopControl Web - Todos los derechos reservados.
                    </RadzenText>
                </div>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private string? errorMessage;
    private InputModel Input = new();

    public class InputModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public async Task OnLogin()
    {
        var user = userService.Verify(Input.Email, Input.Password);
        if (user == null)
        {
            errorMessage = "Credenciales inválidas o cuenta inactiva.";
            return;
        }

        var claims = new List<Claim> {
            new Claim(ClaimTypes.Name, user.Email),
            new Claim(ClaimTypes.Role, user.Role)
        };

        var claimIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        ClaimsPrincipal claimsPrincipal = new ClaimsPrincipal(claimIdentity);
        Guid key = Guid.NewGuid();
        AuthMiddleware.Logins[key] = claimsPrincipal;
        nav.NavigateTo($"/login?key={key}", forceLoad: true);
    }
}