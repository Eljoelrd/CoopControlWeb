@page "/perfil"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CoopControlWeb.Modelos
@inject AuthenticationStateProvider AuthProvider
@inject UserService userService
@rendermode InteractiveServer

<PageTitle>Mi Perfil - CoopControl Web</PageTitle>

@if (user is not null && user.Identity is not null && user.Identity.IsAuthenticated)
{
    <RadzenRow Gap="1.5rem" AlignItems="AlignItems.Center" Class="rz-mb-6">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Mi Panel de Usuario</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Visualice sus datos personales y nivel de acceso al sistema.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="rz-text-align-right">
            @* BOTÓN CLAVE: Redirige a Configuraciones para editar *@
            <RadzenButton Text="Editar Perfil y Seguridad" Icon="settings" ButtonStyle="ButtonStyle.Primary" 
                          Click="@(() => Navigation.NavigateTo("/configuraciones"))" Size="ButtonSize.Large" 
                          Style="border-radius: 20px;" Class="rz-shadow-2" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow Gap="1.5rem">
        @* --- COLUMNA IZQUIERDA: TARJETA DE RESUMEN --- *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Class="rz-shadow-3 rz-border-radius-2 text-center rz-p-8 rz-background-color-panel">
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                    @* Avatar con iniciales grande *@
                    <RadzenAvatar Text="@($"{dbUser?.Nombre?[0]}{dbUser?.Apellido?[0]}")" 
                                  Style="width: 100px; height: 100px; font-size: 2.5rem; background-color: var(--rz-primary); color: white;" 
                                  Class="rz-shadow-3" />
                    
                    <div>
                        <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0"><b>@dbUser?.Nombre @dbUser?.Apellido</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-primary);">@role</RadzenText>
                    </div>

                    <div style="width: 100%;">
                        <hr style="border-top: 1px solid var(--rz-border-color); margin: 10px 0;" />
                    </div>
                    
                    <RadzenIcon Icon="mail" Style="color: var(--rz-primary)" />
                    <RadzenText TextStyle="TextStyle.Body2">@dbUser?.Email</RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* --- COLUMNA DERECHA: DATOS DE SOLO LECTURA --- *@
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenStack Gap="1.5rem">
                
                @* Tarjeta 1: Información Personal (Vista) *@
                <RadzenCard Class="rz-shadow-3 rz-border-radius-2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-4">
                        <RadzenIcon Icon="badge" Style="color: var(--rz-primary)" />
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0">Datos Personales Registrados</RadzenText>
                    </RadzenStack>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-my-0">Nombres</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@dbUser?.Nombre</b></RadzenText>
                            
                            <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-4 rz-my-0">Apellidos</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@dbUser?.Apellido</b></RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-my-0">Correo Electrónico Principal</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">@user.Identity.Name</RadzenText>

                            <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-4 rz-my-0">ID del Usuario en Sistema</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">#@dbUser?.Id</RadzenText>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCard>

                @* Tarjeta 2: Nivel de Acceso (Vista) *@
                <RadzenCard Class="rz-shadow-3 rz-border-radius-2 rz-background-color-primary-lighter">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-4">
                        <RadzenIcon Icon="lock" Style="color: var(--rz-primary)" />
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0" Style="color: var(--rz-primary);">Nivel de Acceso Actual</RadzenText>
                    </RadzenStack>

                    <RadzenStack Gap="1rem" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenBadge Text="@role" BadgeStyle="BadgeStyle.Primary" IsPill="true" Style="font-size: 1.1rem; padding: 0.6rem 1.2rem;" />
                        
                        <div class="rz-ms-4">
                            @if (user.IsInRole("Admin"))
                            {
                                <RadzenText TextStyle="TextStyle.Body2"><b>Permisos Totales:</b> Usted es administrador. Tiene control completo sobre socios, aportes, préstamos, reportes y configuraciones globales.</RadzenText>
                            }
                            else if (user.IsInRole("Cajero"))
                            {
                                <RadzenText TextStyle="TextStyle.Body2"><b>Permisos Operativos:</b> Usted es cajero. Puede registrar y gestionar transacciones de aportes y desembolsos de préstamos.</RadzenText>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.Body2"><b>Permisos de Consulta:</b> Usted es socio. Puede visualizar sus propios registros históricos de aportes, préstamos y certificados.</RadzenText>
                            }
                        </div>
                    </RadzenStack>
                </RadzenCard>

            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}
else
{
    @* Pantalla de No Autenticado (Sigue igual) *@
    <RadzenCard Class="rz-shadow-10 text-center rz-p-12 rz-mt-12">
        <RadzenIcon Icon="account_circle" Style="font-size: 5rem; color: var(--rz-text-disabled-color);" />
        <RadzenText TextStyle="TextStyle.H5" Class="rz-mt-6">Acceso Restringido</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Class="rz-mb-6">Debe iniciar sesión para visualizar los detalles de su cuenta personal.</RadzenText>
        <RadzenButton Text="Ir al Login" Icon="login" ButtonStyle="ButtonStyle.Primary" 
                      Click="@(() => Navigation.NavigateTo("/login"))" Size="ButtonSize.Large" Style="border-radius: 20px;" />
    </RadzenCard>
}

@code {
    private ClaimsPrincipal? user;
    private string? role;
    private User? dbUser;

    [Inject] NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        user = state.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            role = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Socio";
            var email = user.Identity.Name;
            
            try {
                // Obtenemos los datos extendidos del UserService
                dbUser = userService.GetByEmail(email);
            } catch {
                // Fallback de seguridad si userService falla
                dbUser = new User { Nombre = "Usuario", Apellido = "(Sin Datos)", Email = email };
            }
        }
    }
}