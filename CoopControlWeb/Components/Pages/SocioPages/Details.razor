@page "/socios/details"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Cajero")]
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Expediente del Socio</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
            
            @if (socios == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Consultando expediente...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                    
                    @* Cabecera con Color de Acento (Primary para Vista) *@
                    <div style="background-color: var(--rz-primary); height: 10px; width: 100%;"></div>
                    
                    <div class="rz-p-6 rz-p-md-10">
                        @* Encabezado con Avatar Simbólico *@
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem" Class="rz-mb-8">
                            <RadzenAvatar Text="@($"{socios.Nombre?[0]}{socios.Apellido?[0]}")" 
                                          Style="width: 80px; height: 80px; font-size: 1.5rem; background-color: var(--rz-primary-lighter); color: var(--rz-primary-darker);" />
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">@socios.Nombre @socios.Apellido</RadzenText>
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Socio Activo" IsPill="true" Style="width: fit-content;" />
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenStack Gap="1.5rem">
                            
                            @* Fila de Identidad (Solo lectura) *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Cédula" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@socios.Cedula" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Sexo / Estado Civil" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@($"{socios.Sexo} - {socios.EstadoCivil}")" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Fila de Contacto *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@socios.Telefono" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Correo Electrónico" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@socios.Email" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Dirección Registrada" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextArea Value="@socios.Direccion" ReadOnly="true" Rows="2" />
                            </RadzenFormField>

                            @* Fila de Fechas *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Fecha de Nacimiento" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@socios.FechaNacimiento.ToString("dd/MM/yyyy")" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Fecha de Ingreso" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox Value="@socios.FechaIngreso.ToString("dd/MM/yyyy")" ReadOnly="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Acciones del Expediente *@
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-8 rz-pt-4" Style="border-top: 1px solid var(--rz-divider);">
                                <RadzenButton Text="Cerrar" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" 
                                              Click="@(() => NavigationManager.NavigateTo("/socios"))" />
                                
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="Estado de Cuenta" Icon="account_balance_wallet" ButtonStyle="ButtonStyle.Info" 
                                                  Click="@(() => NavigationManager.NavigateTo($"/socios/estado/{socios.Id}"))" />
                                    
                                    <RadzenButton Text="Editar" Icon="edit" ButtonStyle="ButtonStyle.Warning" 
                                                  Click="@(() => NavigationManager.NavigateTo($"/socios/edit?id={socios.Id}"))" Style="color: black;" />
                                </RadzenStack>
                            </RadzenStack>

                        </RadzenStack>
                    </div>
                </RadzenCard>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Socios? socios;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        socios = await context.Socios.FirstOrDefaultAsync(m => m.Id == Id);

        if (socios == null)
        {
            NavigationManager.NavigateTo("/socios");
        }
    }
}