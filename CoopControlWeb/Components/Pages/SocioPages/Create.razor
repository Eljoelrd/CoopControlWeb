@page "/socios/create"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Cajero")]
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Nuevo Socio</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="10" SizeLG="8">

            <RadzenTemplateForm TItem="Socios" Data="@Socios" Submit="@AddSocios">
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                    @* Cabecera con Color de Acento *@
                    <div style="background-color: var(--rz-primary); height: 10px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Crear Socio</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Ingrese los datos para registrar un nuevo miembro en la cooperativa.</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="1.5rem">

                            @* Sección: Datos de Identidad *@
                            <div class="rz-display-flex rz-align-items-center rz-mb-2">
                                <RadzenIcon Icon="badge" Class="rz-me-2" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>Identidad</b></RadzenText>
                            </div>

                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Cédula" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenMask Mask="***-*******-*" CharacterPattern="[0-9]" @bind-Value="Socios.Cedula" Name="Cedula" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Cedula" Text="La cédula es obligatoria" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Socios.Nombre" Name="Nombre" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Nombre" Text="Campo requerido" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Apellido" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Socios.Apellido" Name="Apellido" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Apellido" Text="Campo requerido" />
                                </RadzenColumn>
                            </RadzenRow>

                            @* Sección: Perfil Personal *@
                            <div class="rz-display-flex rz-align-items-center rz-mt-4 rz-mb-2">
                                <RadzenIcon Icon="person" Class="rz-me-2" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>Información Personal</b></RadzenText>
                            </div>

                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Sexo" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="Socios.Sexo" Data="@(new[] { "Masculino", "Femenino" })" Name="Sexo" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Sexo" Text="Requerido" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Estado Civil" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="Socios.EstadoCivil" Data="@(new[] { "Soltero(a)", "Casado(a)", "Divorciado(a)", "Viudo(a)", "Unión Libre" })" Name="EstadoCivil" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="EstadoCivil" Text="Requerido" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Tipo de Sangre" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="Socios.TipoSangre" Data="@(new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Nacionalidad" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Socios.Nacionalidad" Name="Nacionalidad" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Fecha de Nacimiento" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDatePicker @bind-Value="Socios.FechaNacimiento" DateFormat="dd/MM/yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Fecha de Ingreso" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDatePicker @bind-Value="Socios.FechaIngreso" DateFormat="dd/MM/yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Sección: Contacto *@
                            <div class="rz-display-flex rz-align-items-center rz-mt-4 rz-mb-2">
                                <RadzenIcon Icon="contact_mail" Class="rz-me-2" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>Contacto</b></RadzenText>
                            </div>

                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenMask Mask="(***) ***-****" CharacterPattern="[0-9]" @bind-Value="Socios.Telefono" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Correo Electrónico" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Socios.Email" Name="Email" />
                                    </RadzenFormField>
                                    <RadzenEmailValidator Component="Email" Text="Email inválido" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Dirección" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="Socios.Direccion" Rows="2" />
                            </RadzenFormField>

                            @* Botones *@
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                <RadzenButton Text="Volver" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                              Click="@(() => NavigationManager.NavigateTo("/socios"))" />
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar Socio" Icon="save"
                                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Style="border-radius: 25px; padding: 0 2rem;" />
                            </RadzenStack>

                        </RadzenStack>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Socios Socios { get; set; } = new() 
    { 
        FechaNacimiento = DateTime.Today.AddYears(-18), 
        FechaIngreso = DateTime.Today,
        Nacionalidad = "Dominicana"
    };

    private async Task AddSocios()
    {
        try 
        {
            // LIMPIEZA DE DATOS: Quitamos guiones y formatos para que quepan en la DB
            if (!string.IsNullOrEmpty(Socios.Cedula))
                Socios.Cedula = Socios.Cedula.Replace("-", "").Replace("_", "").Trim();

            if (!string.IsNullOrEmpty(Socios.Telefono))
                Socios.Telefono = Socios.Telefono.Replace("(", "").Replace(")", "").Replace("-", "").Replace(" ", "").Trim();

            using var context = DbFactory.CreateDbContext();
            context.Socios.Add(Socios);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/socios");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar: {ex.Message}");
        }
    }
}