@page "/socios/edit"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Editar Socio</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

            @if (Socios == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Cargando datos del socio...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenTemplateForm TItem="Socios" Data="@Socios" Submit="@UpdateSocios">
                    <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                        @* Cabecera con Color de Acento (Warning para Edición) *@
                        <div style="background-color: var(--rz-warning); height: 10px; width: 100%;"></div>

                        <div class="rz-p-6 rz-p-md-10">
                            <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="edit_square" Style="color: var(--rz-warning)" />
                                    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Editar Socio</RadzenText>
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Actualice la información del miembro seleccionado.</RadzenText>
                            </RadzenStack>

                            <RadzenStack Gap="1.5rem">

                                @* Identidad *@
                                <div class="rz-display-flex rz-align-items-center rz-mb-2">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0 rz-color-primary"><b>1. Identidad Principal</b></RadzenText>
                                </div>

                                <RadzenFormField Text="Cédula" Variant="Variant.Outlined" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenMask Mask="***-*******-*" CharacterPattern="[0-9]" @bind-Value="Socios.Cedula" Name="Cedula" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Cedula" Text="La cédula es requerida" />
                                    </Helper>
                                </RadzenFormField>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="Socios.Nombre" Name="Nombre" />
                                        </RadzenFormField>
                                        <RadzenRequiredValidator Component="Nombre" Text="Campo requerido" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Apellido" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="Socios.Apellido" Name="Apellido" />
                                        </RadzenFormField>
                                        <RadzenRequiredValidator Component="Apellido" Text="Campo requerido" />
                                    </RadzenColumn>
                                </RadzenRow>

                                @* Contacto *@
                                <div class="rz-display-flex rz-align-items-center rz-mt-4 rz-mb-2">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0 rz-color-primary"><b>2. Información de Contacto</b></RadzenText>
                                </div>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenMask Mask="(***) ***-****" CharacterPattern="[0-9]" @bind-Value="Socios.Telefono" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="Socios.Email" Name="Email" />
                                        </RadzenFormField>
                                        <RadzenEmailValidator Component="Email" Text="Formato de email incorrecto" />
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenFormField Text="Dirección Residencial" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextArea @bind-Value="Socios.Direccion" Rows="2" />
                                </RadzenFormField>

                                @* Botones de Acción *@
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-8 rz-pt-4" Style="border-top: 1px solid var(--rz-divider);">
                                    <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Click="@(() => NavigationManager.NavigateTo("/socios"))" />

                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Actualizar Datos" Icon="save"
                                                  ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Large"
                                                  Style="border-radius: 25px; padding: 0 2rem; color: black;" />
                                </RadzenStack>

                            </RadzenStack>
                        </div>
                    </RadzenCard>
                </RadzenTemplateForm>
            }

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Socios? Socios { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Socios = await context.Socios.FirstOrDefaultAsync(m => m.Id == Id);

        if (Socios == null)
        {
            NavigationManager.NavigateTo("/socios");
        }
    }

    private async Task UpdateSocios()
    {
        if (Socios != null)
        {
            using var context = DbFactory.CreateDbContext();
            context.Attach(Socios).State = EntityState.Modified;

            try
            {
                // LIMPIEZA DE DATOS: Quitamos guiones y formatos para que quepan en la DB
                if (!string.IsNullOrEmpty(Socios.Cedula))
                    Socios.Cedula = Socios.Cedula.Replace("-", "").Replace("_", "").Trim();

                if (!string.IsNullOrEmpty(Socios.Telefono))
                    Socios.Telefono = Socios.Telefono.Replace("(", "").Replace(")", "").Replace("-", "").Replace(" ", "").Trim();

                await context.SaveChangesAsync();
                NavigationManager.NavigateTo("/socios");
            }
            catch (DbUpdateConcurrencyException)
            {
                // Manejo de error si otro usuario editó al mismo tiempo
                throw;
            }
        }
    }
}