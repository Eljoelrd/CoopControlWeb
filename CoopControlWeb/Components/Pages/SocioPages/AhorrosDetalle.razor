@page "/socios/ahorros"
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@using static System.Runtime.InteropServices.JavaScript.JSType
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Cajero")]
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Cuenta de Ahorros del Socio</PageTitle>

<div class="rz-p-6">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Socio" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="selectedSocioId"
                                Data="@socios"
                                TextProperty="NombreCompleto"
                                ValueProperty="Id"
                                AllowFiltering="true"
                                Placeholder="Seleccione un socio..."
                                Change="@(async (object value) => await OnSocioChanged((int?)value))" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    @if (selectedSocioId == null)
    {
        <RadzenAlert Title="Consulta de Cuentas" AlertStyle="AlertStyle.Base" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="true" Class="rz-mt-4">
            Por favor, utilice el selector superior para cargar la información financiera de un socio.
        </RadzenAlert>
    }
    else
    {
        <RadzenRow Class="rz-mt-6" Gap="1.5rem">
            @* Columna Izquierda: Métricas y Distribución *@
            <RadzenColumn Size="12" SizeLG="4">
                <RadzenStack Gap="1rem">
                    <RadzenCard Variant="Variant.Flat" Class="rz-p-5" Style="border-radius: 12px; background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%); color: white;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline" Class="rz-color-white rz-m-0" Style="opacity: 0.9; font-weight: 700; letter-spacing: 1px;">LIQUIDEZ TOTAL</RadzenText>
                                <RadzenText TextStyle="TextStyle.H4" Class="rz-color-white rz-m-0"><b>RD$ @totalDisponible.ToString("N2")</b></RadzenText>
                            </RadzenStack>
                            <RadzenIcon Icon="account_balance_wallet" Style="font-size: 3rem; color: rgba(255,255,255,0.25);" />
                        </RadzenStack>
                    </RadzenCard>

                    <RadzenCard Variant="Variant.Outlined" Class="rz-p-4 rz-background-color-base-100">
                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Caption" Class="rz-m-0 rz-color-base-500">Saldo Capital</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0 rz-color-primary"><b>@totalSaldo.ToString("C")</b></RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="6" Class="rz-text-align-right">
                                <RadzenText TextStyle="TextStyle.Caption" Class="rz-m-0 rz-color-base-500">Interés Estimado</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0 rz-color-success"><b>+ @totalInteres.ToString("C")</b></RadzenText>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>

                    <RadzenCard Variant="Variant.Outlined" Class="rz-p-4">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TextAlign="TextAlign.Center" Class="rz-mb-4">Composición de Cartera</RadzenText>
                        <RadzenChart Style="height: 200px;">
                            <RadzenDonutSeries Data="@ahorros" CategoryProperty="Tipo" ValueProperty="Saldo" TItem="AhorroView">
                                <TooltipTemplate Context="data">
                                    @(((AhorroView)data).Tipo): <b>@(((AhorroView)data).Saldo.ToString("C"))</b>
                                </TooltipTemplate>
                            </RadzenDonutSeries>
                        </RadzenChart>
                    </RadzenCard>
                </RadzenStack>
            </RadzenColumn>

            @* Columna Derecha: Acordeón de Productos *@
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenText TextStyle="TextStyle.H6" Class="rz-mb-4">Productos de Ahorro Activos</RadzenText>
                <RadzenAccordion Multiple="false">
                    <Items>
                        @foreach (var a in ahorros)
                        {
                            <RadzenAccordionItem Icon="account_balance">
                                <Template>
                                    <div class="rz-d-flex rz-justify-content-space-between rz-align-items-center" style="width: 100%;">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0"><b>@a.Tipo</b></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0 rz-color-primary"><b>@a.Saldo.ToString("C")</b></RadzenText>
                                    </div>
                                </Template>
                                <ChildContent>
                                    <RadzenRow Gap="1rem" Class="rz-p-2">
                                        <RadzenColumn Size="12" SizeMD="8">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenText TextStyle="TextStyle.Body2">Tasa de Interés: <b>@a.TasaInteresAnual% anual</b></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2">Vencimiento: <b>@(a.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "A la vista")</b></RadzenText>
                                                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Text" Size="AlertSize.Small" AllowClose="false" Class="rz-mt-2">
                                                    @GetReglaNegocio(a.Tipo)
                                                </RadzenAlert>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4" Class="rz-text-align-right">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenButton Text="Solicitar Retiro" Icon="file_download" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => SolicitarRetiro(a.Id))" />
                                                <RadzenButton Text="Ver Historial" Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(async () => await ToggleDetalleAhorro(a.Id))" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    @if (expandedAhorroId == a.Id)
                                    {
                                        <RadzenDataGrid Data="@movimientos" TItem="MovimientoView" Density="Density.Compact" Class="rz-mt-4" AllowPaging="true" PageSize="5">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="MovimientoView" Property="Fecha" Title="Fecha" FormatString="{0:dd/MM/yyyy}" Width="100px" />
                                                <RadzenDataGridColumn TItem="MovimientoView" Property="Tipo" Title="Tipo" Width="120px" />
                                                <RadzenDataGridColumn TItem="MovimientoView" Property="Monto" Title="Monto" TextAlign="TextAlign.Right">
                                                    <Template Context="m">
                                                        <span class="rz-color-primary"><b>@m.Monto.ToString("N2")</b></span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </ChildContent>
                            </RadzenAccordionItem>
                        }
                    </Items>
                </RadzenAccordion>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Class="rz-mt-8">
            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Flat" Class="rz-background-color-base-100">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0">Historial Global de Movimientos</RadzenText>
                        <RadzenButton Text="Exportar CSV" Icon="description" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
                    </RadzenStack>
                    <RadzenDataGrid Data="@movimientos" TItem="MovimientoView" AllowPaging="true" PageSize="10" AllowSorting="true" 
                                    AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                        <Columns>
                            <RadzenDataGridColumn TItem="MovimientoView" Property="Fecha" Title="Fecha" FormatString="{0:dd/MM/yyyy HH:mm}" Width="160px" />
                            <RadzenDataGridColumn TItem="MovimientoView" Property="Tipo" Title="Tipo" Width="140px">
                                <Template Context="m">
                                    <RadzenBadge Text="@m.Tipo" IsPill="true" BadgeStyle="@(m.Tipo == "Aporte" ? BadgeStyle.Info : BadgeStyle.Primary)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MovimientoView" Property="Descripcion" Title="Concepto / Referencia" />
                            <RadzenDataGridColumn TItem="MovimientoView" Property="Monto" Title="Monto" TextAlign="TextAlign.Right" Width="150px">
                                <Template Context="m">
                                    <span style="font-weight: bold; color: var(--rz-primary);">@m.Monto.ToString("C")</span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenButton Text="Cerrar" Icon="arrow_back" Style="width: fit-content;" Variant="Variant.Text" 
                                              Click="@(() => NavigationManager.NavigateTo("/socios"))" />
    }
</div>

@code {
    private string GetReglaNegocio(string tipo)
    {
        if (tipo == TipoAhorro.Normal.ToString()) return "Aporte obligatorio: 2% del salario (solo retiro al desvincularse; 90 días tras solicitud).";
        if (tipo == TipoAhorro.Especial.ToString()) return "Ahorro Especial: equivalente al 5% del salario. Interés: 6% anual.";
        if (tipo == TipoAhorro.Navideno.ToString()) return "Ahorro Navideño: entrega en diciembre. Interés: 7% anual.";
        if (tipo == TipoAhorro.Escolar.ToString()) return "Ahorro Escolar: entrega en julio. Interés: 5% anual.";
        if (tipo == TipoAhorro.Infantil.ToString()) return "Ahorro Infantil: disponible al cumplir 18 años del beneficiario. Interés: 5% anual.";
        if (tipo == TipoAhorro.ClubViajes.ToString()) return "Ahorro Club de Viajes: después de 6 cuotas ininterrumpidas accede a beneficios.";
        if (tipo == TipoAhorro.InversionCapital.ToString()) return "Inversión a plazo fijo (6m/1a/3a). Interés variable.";
        return "Consulte los términos de este producto con un oficial.";
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "socioId")]
    public int? SocioIdFromQuery { get; set; }

    private int? selectedSocioId;
    private List<SocioOption> socios = new();
    private List<AhorroView> ahorros = new();

    private decimal totalSaldo = 0m;
    private decimal totalInteres = 0m;
    private decimal totalDisponible = 0m;

    private int? expandedAhorroId;
    private List<MovimientoView> movimientos = new();

    protected override async Task OnInitializedAsync()
    {
        using var ctx = DbFactory.CreateDbContext();

        socios = await ctx.Socios
            .OrderBy(s => s.Nombre)
            .ThenBy(s => s.Apellido)
            .Select(s => new SocioOption
            {
                Id = s.Id,
                NombreCompleto = s.Nombre + " " + s.Apellido + " - " + s.Cedula
            })
            .ToListAsync();

        if (SocioIdFromQuery.HasValue)
        {
            selectedSocioId = SocioIdFromQuery.Value;
            await LoadAhorros(selectedSocioId.Value);
            await LoadMovimientos(selectedSocioId.Value);
        }
    }

    private async Task OnSocioChanged(int? value)
    {
        selectedSocioId = value;
        if (selectedSocioId.HasValue)
        {
            await LoadAhorros(selectedSocioId.Value);
            await LoadMovimientos(selectedSocioId.Value);
        }
        else
        {
            ahorros.Clear();
            movimientos.Clear();
        }
    }

    private async Task LoadAhorros(int socioId)
    {
        using var ctx = DbFactory.CreateDbContext();

        var entities = await ctx.Ahorros
            .Where(a => a.SocioId == socioId)
            .OrderBy(a => a.Tipo)
            .ToListAsync();

        var list = entities.Select(a => new AhorroView
        {
            Id = a.Id,
            Tipo = a.Tipo.ToString(),
            Saldo = a.Saldo,
            TasaInteresAnual = a.TasaInteresAnual > 0 ? a.TasaInteresAnual : Ahorro.GetDefaultTasaInteres(a.Tipo),
            FechaVencimiento = a.FechaVencimiento,
            Notas = a.Notas
        }).ToList();

        ahorros = list;

        totalSaldo = ahorros.Sum(x => x.Saldo);
        totalInteres = ahorros.Sum(x => x.Saldo * x.TasaInteresAnual / 100m);
        totalDisponible = totalSaldo + totalInteres;
    }

    private async Task LoadMovimientos(int socioId)
    {
        using var ctx = DbFactory.CreateDbContext();

        var depositos = await ctx.Depositos
            .Where(d => d.SocioId == socioId)
            .OrderByDescending(d => d.FechaDeposito)
            .Select(d => new MovimientoView
            {
                Fecha = d.FechaDeposito,
                Tipo = d.TipoDeposito,
                Descripcion = d.ReferenciaExterna ?? d.Observaciones ?? string.Empty,
                Monto = d.Monto
            })
            .ToListAsync();

        var aportes = await ctx.Aportes
            .Where(a => a.SocioId == socioId)
            .OrderByDescending(a => a.Fecha)
            .Select(a => new MovimientoView
            {
                Fecha = a.Fecha,
                Tipo = "Aporte",
                Descripcion = a.Concepto ?? string.Empty,
                Monto = a.Monto
            })
            .ToListAsync();

        movimientos = depositos.Concat(aportes).OrderByDescending(m => m.Fecha).ToList();
    }

    private async Task ToggleDetalleAhorro(int ahorroId)
    {
        if (expandedAhorroId == ahorroId)
        {
            expandedAhorroId = null;
        }
        else
        {
            expandedAhorroId = ahorroId;
            // Already loaded movimientos por socio; if want to filter by ahorro, additional linkage required
        }
    }

    private void SolicitarRetiro(int ahorroId)
    {
        // Navegar a formulario de solicitud de retiro - implementar la ruta seg n su aplicaci n
        NavigationManager.NavigateTo($"/retiros/solicitar?socioId={selectedSocioId}&ahorroId={ahorroId}");
    }

    // ----- Vistas internas -----
    private class SocioOption
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
    }

    private class AhorroView
    {
        public int Id { get; set; }
        public string Tipo { get; set; } = string.Empty;
        public decimal Saldo { get; set; }
        public decimal TasaInteresAnual { get; set; }
        public DateTime? FechaVencimiento { get; set; }
        public string? Notas { get; set; }
        public decimal InteresCalculado => Saldo * TasaInteresAnual / 100m;
    }

    private class MovimientoView
    {
        public DateTime Fecha { get; set; }
        public string Tipo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Monto { get; set; }
    }

    
}
