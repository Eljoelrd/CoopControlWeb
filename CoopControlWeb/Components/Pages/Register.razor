@page "/register"
@using System.ComponentModel.DataAnnotations
@using CoopControlWeb.Modelos
@using static BCrypt.Net.BCrypt
@inject UserService userService
@inject NavigationManager nav
@rendermode InteractiveServer

<PageTitle>Prototipo - Registro de Usuario</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="5">

            <RadzenTemplateForm TItem="InputModel" Data="@Input" Submit="@RegisterUser">
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                    <div style="background-color: var(--rz-secondary); height: 10px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-6">
                            <RadzenIcon Icon="person_add" Size="32px" Style="color: var(--rz-secondary)" />
                            <RadzenText TextStyle="TextStyle.H4" Class="rz-m-0">Crear Cuenta</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="1.5rem">
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Input.Nombre" Name="Nombre" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Nombre" Text="Requerido" />
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Apellido" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="Input.Apellido" Name="Apellido" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Apellido" Text="Requerido" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Correo Electrónico" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="Input.Email" Name="Email" />
                            </RadzenFormField>
                            <RadzenEmailValidator Component="Email" Text="Email inválido" />

                            <RadzenFormField Text="Contraseña" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenPassword @bind-Value="Input.Password" Name="Password" />
                            </RadzenFormField>

                            <RadzenFormField Text="Asignar Rol" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenDropDown @bind-Value="Input.Role" Data="@roles" Name="Role" />
                            </RadzenFormField>

                            <RadzenButton ButtonType="ButtonType.Submit" Text="Registrar Usuario"
                                          ButtonStyle="ButtonStyle.Secondary" Class="rz-w-100 rz-mt-4"
                                          Style="border-radius: 20px; height: 45px;" />

                            <RadzenButton Text="Volver al Login" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                          Click="@(() => nav.NavigateTo("/login"))" Class="rz-w-100" />
                        </RadzenStack>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private InputModel Input = new();
    private List<string> roles = new() { "Admin", "Socio", "Cajero" };

    public void RegisterUser()
    {
        string hashedPassword = HashPassword(Input.Password);

        var newUser = new User
        {
            Nombre = Input.Nombre,
            Apellido = Input.Apellido,
            Email = Input.Email,
            PasswordHash = hashedPassword,
            Role = Input.Role,
            Estado = true,
            FechaRegistro = DateTime.Now
        };

        if (userService.SaveUser(newUser))
        {
            nav.NavigateTo("/login");
        }
    }

    public class InputModel
    {
        public string Nombre { get; set; } = "";
        public string Apellido { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Role { get; set; } = "Socio";
    }
}