@page "/"

<PageTitle>Inicio</PageTitle>

<RadzenCard>
    <h2>¡Bienvenido a CoopControl!</h2>
    <p>Sistema de gestión para cooperativas</p>

 
</RadzenCard>

<RadzenCard Style="margin-top: 1.5rem;">
    <h3>Estadísticas Rápidas</h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
        <RadzenCard>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <RadzenIcon Icon="people" Style="font-size: 2rem; color: #667eea;" />
                <div>
                    <h4 style="margin: 0;">1,234</h4>
                    <small style="color: var(--text-secondary);">Total Socios</small>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <RadzenIcon Icon="account_balance" Style="font-size: 2rem; color: #4caf50;" />
                <div>
                    <h4 style="margin: 0;">45</h4>
                    <small style="color: var(--text-secondary);">Cooperativas</small>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <RadzenIcon Icon="attach_money" Style="font-size: 2rem; color: #ffc107;" />
                <div>
                    <h4 style="margin: 0;">$2.5M</h4>
                    <small style="color: var(--text-secondary);">Capital Social</small>
                </div>
            </div>
        </RadzenCard>
    </div>
</RadzenCard>