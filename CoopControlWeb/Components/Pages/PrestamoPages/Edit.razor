@page "/prestamos/edit"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Prototipo - Editar Préstamo</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

            @if (Prestamo == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Cargando datos del préstamo...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenTemplateForm TItem="Prestamo" Data="@Prestamo" Submit="@UpdatePrestamo">
                    <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                        <div style="background-color: var(--rz-warning); height: 10px; width: 100%;"></div>

                        <div class="rz-p-6 rz-p-md-10">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-6">
                                <RadzenIcon Icon="edit_document" Style="color: var(--rz-warning)" />
                                <RadzenText TextStyle="TextStyle.H4" Class="rz-m-0">Ajustar Préstamo</RadzenText>
                            </RadzenStack>

                            <RadzenStack Gap="1.5rem">
                                <RadzenFormField Text="Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDropDown @bind-Value="Prestamo.SocioId" Data="@socios"
                                                    TextProperty="Nombre" ValueProperty="Id" Disabled="true" />
                                </RadzenFormField>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Monto (RD$)" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenNumeric @bind-Value="Prestamo.Monto" TValue="decimal" ShowUpDown="false" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Estado Actual" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="Prestamo.Estado"
                                                            Data="@(new[] { "Activo", "Pagado", "Vencido", "Pendiente" })" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenFormField Text="Fecha de Emisión" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDatePicker @bind-Value="Prestamo.FechaPrestamo" DateFormat="dd/MM/yyyy" />
                                </RadzenFormField>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Click="@(() => NavigationManager.NavigateTo("/prestamos"))" />
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Actualizar Préstamo"
                                                  ButtonStyle="ButtonStyle.Warning" Style="border-radius: 20px; color: black;" />
                                </RadzenStack>
                            </RadzenStack>
                        </div>
                    </RadzenCard>
                </RadzenTemplateForm>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [SupplyParameterFromQuery] private int Id { get; set; }
    private Prestamo? Prestamo { get; set; }
    private List<Socios> socios = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Prestamo = await context.Prestamos.FirstOrDefaultAsync(m => m.Id == Id);
        socios = await context.Socios.ToListAsync();
    }

    private async Task UpdatePrestamo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Prestamo!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/prestamos");
    }
}