@page "/prestamos/edit"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Editar Préstamo</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="10" SizeLG="8">

            @if (Prestamo == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Cargando datos del préstamo...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenTemplateForm TItem="Prestamo" Data="@Prestamo" Submit="@UpdatePrestamo">
                    <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                        @* Barra de acento Warning *@
                        <div style="background-color: var(--rz-warning); height: 10px; width: 100%;"></div>

                        <div class="rz-p-6 rz-p-md-10">
                            <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="edit_note" Style="color: var(--rz-warning); font-size: 2rem;" />
                                    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Modificar Préstamo</RadzenText>
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Actualización de términos y condiciones del crédito.</RadzenText>
                            </RadzenStack>

                            <RadzenStack Gap="1.5rem">
                                
                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenFormField Text="Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="Prestamo.SocioId" Data="@socios" 
                                                           TextProperty="NombreCompleto" ValueProperty="Id" 
                                                           AllowFiltering="true" Name="SocioId" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Estado" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="Prestamo.Estado" Data="@(new[] { "Activo", "Pendiente", "Cerrado", "Vencido" })" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Monto" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenNumeric @bind-Value="Prestamo.Monto" Format="c" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Tasa (%)" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenNumeric @bind-Value="Prestamo.TasaInteres" Format="0.0" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Meses" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenNumeric @bind-Value="Prestamo.PlazoMeses" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Fecha Devolución (Cierre)" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDatePicker @bind-Value="Prestamo.FechaDevolucion" DateFormat="dd/MM/yyyy" Placeholder="Sin devolver" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Método Pago" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="Prestamo.MetodoPagoPreferido" Data="@(new[] { "Efectivo", "Transferencia", "Nómina" })" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenFormField Text="Observaciones" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextArea @bind-Value="Prestamo.Observaciones" Rows="2" />
                                </RadzenFormField>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                    <RadzenButton Text="Cancelar" Icon="cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Click="@(() => NavigationManager.NavigateTo("/prestamos"))" />
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Actualizar Préstamo" Icon="save"
                                                  ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Large" 
                                                  Style="border-radius: 25px; padding: 0 2rem; color: black;" />
                                </RadzenStack>
                            </RadzenStack>
                        </div>
                    </RadzenCard>
                </RadzenTemplateForm>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [SupplyParameterFromQuery] public int Id { get; set; }
    private Prestamo? Prestamo { get; set; }
    private List<SocioDisplay> socios = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Prestamo = await context.Prestamos.FirstOrDefaultAsync(m => m.Id == Id);
        socios = await context.Socios
            .Select(s => new SocioDisplay { Id = s.Id, NombreCompleto = s.Nombre + " " + s.Apellido })
            .ToListAsync();

        if (Prestamo == null) NavigationManager.NavigateTo("/prestamos");
    }

    private async Task UpdatePrestamo()
    {
        if (Prestamo != null)
        {
            using var context = DbFactory.CreateDbContext();
            Prestamo.FechaModificacion = DateTime.Now;
            context.Prestamos.Update(Prestamo);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/prestamos");
        }
    }

    public class SocioDisplay { public int Id { get; set; } public string NombreCompleto { get; set; } }
}