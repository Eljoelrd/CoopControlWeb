@page "/prestamos/delete"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Prototipo - Eliminar Préstamo</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
            @if (prestamo != null)
            {
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                    <div style="background-color: var(--rz-danger); height: 10px; width: 100%;"></div>
                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Gap="0.5rem" Class="rz-mb-6 text-center">
                            <RadzenIcon Icon="warning_amber" Style="color: var(--rz-danger); font-size: 3rem;" />
                            <RadzenText TextStyle="TextStyle.H4">¿Eliminar este préstamo?</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">Esta acción borrará el registro financiero de <b>@prestamo.Socio?.Nombre</b>.</RadzenText>
                        </RadzenStack>

                        <RadzenFormField Text="Monto a Eliminar" Variant="Variant.Outlined" Style="width: 100%;" Class="rz-mb-4">
                            <RadzenTextBox Value="@($"RD$ {prestamo.Monto:N2}")" ReadOnly="true" />
                        </RadzenFormField>

                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                            <RadzenButton Text="No, cancelar" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("/prestamos"))" />
                            <RadzenButton Text="Sí, eliminar" ButtonStyle="ButtonStyle.Danger"
                                          Click="DeletePrestamo" Style="border-radius: 20px;" />
                        </RadzenStack>
                    </div>
                </RadzenCard>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [SupplyParameterFromQuery] private int Id { get; set; }
    private Prestamo? prestamo;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        prestamo = await context.Prestamos.Include(p => p.Socio).FirstOrDefaultAsync(p => p.Id == Id);
    }

    private async Task DeletePrestamo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Prestamos.Remove(prestamo!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/prestamos");
    }
}