@page "/prestamos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Prototipo - Gestión de Préstamos</PageTitle>

<div class="container-fluid mt-4">
    <RadzenStack Gap="1.5rem">

        @* Encabezado de Gestión *@
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="account_balance_wallet" Size="36px" Style="color: var(--rz-primary)" />
                    <div>
                        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Cartera de Préstamos</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">Control de créditos y vencimientos</RadzenText>
                    </div>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" Class="rz-text-align-right">
                <RadzenButton Text="Nuevo Préstamo" Icon="add_card" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large" Click="@(() => NavigationManager.NavigateTo("/prestamos/create"))" />
            </RadzenColumn>
        </RadzenRow>

        @* Kpis Financieros Rápidos *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Flat" Class="rz-background-color-primary-lighter rz-p-4">
                    <RadzenText TextStyle="TextStyle.Overline">Capital en Calle</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5"><b>RD$ @allPrestamos.Sum(p => p.Monto).ToString("N2")</b></RadzenText>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Flat" Class="rz-background-color-warning-lighter rz-p-4">
                    <RadzenText TextStyle="TextStyle.Overline">Préstamos Pendientes</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5"><b>@allPrestamos.Count(p => p.Estado != "Pagado")</b></RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* Grid de Préstamos *@
        <RadzenCard Class="rz-shadow-4">
            <RadzenDataGrid Data="@allPrestamos" TItem="Prestamo" AllowFiltering="true" AllowPaging="true" PageSize="8" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="Prestamo" Title="Socio">
                        <Template Context="p">
                            <b>@p.Socio?.Nombre @p.Socio?.Apellido</b>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Prestamo" Property="Monto" Title="Monto">
                        <Template Context="p">
                            <span class="rz-color-primary" style="font-weight: bold;">RD$ @p.Monto.ToString("N2")</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Prestamo" Property="FechaPrestamo" Title="Emisión" FormatString="{0:dd/MM/yyyy}" />

                    <RadzenDataGridColumn TItem="Prestamo" Title="Estado" TextAlign="TextAlign.Center">
                        <Template Context="p">
                            <RadzenBadge Text="@p.Estado" IsPill="true"
                                         BadgeStyle="@(p.Estado == "Activo" ? BadgeStyle.Success : p.Estado == "Pagado" ? BadgeStyle.Info : BadgeStyle.Warning)" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Prestamo" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="150px">
                        <Template Context="p">
                            <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(() => NavigationManager.NavigateTo($"/prestamos/details?id={p.Id}"))" />
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(() => NavigationManager.NavigateTo($"/prestamos/edit?id={p.Id}"))" Class="rz-mx-1" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(() => NavigationManager.NavigateTo($"/prestamos/delete?id={p.Id}"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenStack>
</div>

@code {
    private List<Prestamo> allPrestamos = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        allPrestamos = await context.Prestamos.Include(p => p.Socio).ToListAsync();
    }
}