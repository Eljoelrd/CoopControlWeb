@using System.ComponentModel.DataAnnotations
@using CoopControlWeb.Modelos
@using Microsoft.AspNetCore.Components.Authorization
@using Proyecto_Final.Modelos
@inject AuthenticationStateProvider AuthProvider
@inject UserService userService
@rendermode InteractiveServer

<RadzenText TextStyle="TextStyle.Subtitle1"><b>Cambiar Contraseña</b></RadzenText>

<RadzenTemplateForm TItem="PasswordModel" Data="@passwordModel" Submit="@CambiarPassword">
    <RadzenStack Gap="1.5rem" Style="max-width: 450px;">
        <RadzenFormField Text="Contraseña actual" Variant="Variant.Outlined">
            <RadzenPassword @bind-Value="@passwordModel.CurrentPassword" Name="CurrentPassword" Style="width: 100%;" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="CurrentPassword" Text="La contraseña actual es obligatoria" Style="position: absolute" />

        <RadzenFormField Text="Nueva contraseña" Variant="Variant.Outlined">
            <RadzenPassword @bind-Value="@passwordModel.NewPassword" Name="NewPassword" Style="width: 100%;" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="NewPassword" Text="La nueva contraseña es obligatoria" Style="position: absolute" />
        <RadzenLengthValidator Component="NewPassword" Min="6" Text="Debe tener al menos 6 caracteres" Style="position: absolute" />

        <RadzenFormField Text="Confirmar nueva contraseña" Variant="Variant.Outlined">
            <RadzenPassword @bind-Value="@passwordModel.ConfirmPassword" Name="ConfirmPassword" Style="width: 100%;" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="ConfirmPassword" Text="Debe confirmar la contraseña" Style="position: absolute" />
        <RadzenCompareValidator Component="ConfirmPassword" Value="@passwordModel.NewPassword" Text="Las contraseñas no coinciden" Style="position: absolute" />

        <RadzenButton ButtonType="ButtonType.Submit" Text="Actualizar contraseña" Icon="lock_reset" ButtonStyle="ButtonStyle.Warning" Class="rz-mt-2" />
    </RadzenStack>
</RadzenTemplateForm>

@if (!string.IsNullOrEmpty(passwordMessage))
{
    <RadzenAlert AlertStyle="@passwordAlertStyle" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="true" Class="rz-mt-4">
        @passwordMessage
    </RadzenAlert>
}

@code {
    private PasswordModel passwordModel = new();
    private string passwordMessage = "";
    private AlertStyle passwordAlertStyle = AlertStyle.Info;

    private async Task CambiarPassword()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var currentUser = state.User;

        if (currentUser.Identity is not null && currentUser.Identity.IsAuthenticated)
        {
            var email = currentUser.Identity.Name;
            var dbUser = userService.GetByEmail(email);

            if (dbUser != null && BCrypt.Net.BCrypt.Verify(passwordModel.CurrentPassword, dbUser.PasswordHash))
            {
                dbUser.PasswordHash = BCrypt.Net.BCrypt.HashPassword(passwordModel.NewPassword);
                userService.UpdateUser(dbUser);

                passwordMessage = "Contraseña actualizada correctamente ✅";
                passwordAlertStyle = AlertStyle.Success;
                // Reiniciar formulario
                passwordModel = new PasswordModel();
            }
            else
            {
                passwordMessage = "La contraseña actual no es correcta ❌";
                passwordAlertStyle = AlertStyle.Danger;
            }
        }
    }

    public class PasswordModel
    {
        [Required(ErrorMessage = "La contraseña actual es obligatoria")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "La nueva contraseña es obligatoria")]
        [MinLength(6, ErrorMessage = "Debe tener al menos 6 caracteres")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Debe confirmar la contraseña")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = "";
    }
}