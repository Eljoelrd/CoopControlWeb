@page "/configuraciones"
@rendermode InteractiveServer

<PageTitle>Configuraciones - CoopControl Web</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenStack Gap="1.5rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="settings" Style="font-size: 2rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Configuración del Sistema</RadzenText>
        </RadzenStack>

        <RadzenTabs RenderMode="TabRenderMode.Client">
            <Tabs>
                @* Pestaña de Perfil Personal *@
                <RadzenTabsItem Text="Perfil Personal" Icon="person">
                    <RadzenCard Class="rz-mt-4 rz-shadow-3">
                        <PerfilForm />
                    </RadzenCard>
                </RadzenTabsItem>

                @* Pestaña de Seguridad *@
                <RadzenTabsItem Text="Seguridad y Acceso" Icon="security">
                    <RadzenCard Class="rz-mt-4 rz-shadow-3">
                        <SeguridadForm />
                    </RadzenCard>
                </RadzenTabsItem>

                @* Pestaña de Preferencias (Prototipo para el futuro) *@
                <RadzenTabsItem Text="Preferencias" Icon="tune">
                    <RadzenCard Class="rz-mt-4 rz-shadow-3">
                        <RadzenStack Gap="1rem">
                            <RadzenText TextStyle="TextStyle.H6">Personalización de Interfaz</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                                <RadzenLabel Text="Modo Oscuro" />
                                <RadzenAppearanceToggle />
                                @* Switch de Modo Oscuro: <RadzenSwitch Disabled="true"/> *@ 
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        <RadzenButton Text="Volver" Icon="arrow_back" Variant="Variant.Text"
                      Click="@GoBack" Style="width: fit-content;" />
    </RadzenStack>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
}