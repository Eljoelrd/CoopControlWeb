@using System.ComponentModel.DataAnnotations
@using CoopControlWeb.Modelos
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject UserService userService
@rendermode InteractiveServer

<RadzenTemplateForm TItem="PerfilModel" Data="@perfil" Submit="@GuardarCambiosPerfil">
    <RadzenStack Gap="1.5rem">
        <RadzenText TextStyle="TextStyle.Subtitle1"><b>Información de Contacto</b></RadzenText>

        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenTextBox @bind-Value="perfil.Nombre" Name="Nombre" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Nombre" Text="El nombre es obligatorio" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Apellido" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenTextBox @bind-Value="perfil.Apellido" Name="Apellido" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Apellido" Text="El apellido es obligatorio" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="Correo Electrónico (No editable)" Variant="Variant.Outlined" Style="width: 100%">
            <RadzenTextBox @bind-Value="perfil.Email" Disabled="true" />
        </RadzenFormField>

        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenTextBox @bind-Value="perfil.Telefono" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Dirección" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenTextBox @bind-Value="perfil.Direccion" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (!string.IsNullOrEmpty(perfilMessage))
        {
            <RadzenAlert AlertStyle="@(perfilMessageCss.Contains("success") ? AlertStyle.Success : AlertStyle.Danger)" ShowIcon="true">
                @perfilMessage
            </RadzenAlert>
        }

        <div class="rz-text-align-right">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar Cambios" Icon="check" ButtonStyle="ButtonStyle.Success" />
        </div>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private ClaimsPrincipal? user;
    private PerfilModel perfil = new();

    // Mensajes de feedback
    private string perfilMessage = "";
    private string perfilMessageCss = "";

    // Lógica de inicialización que trae los datos del perfil
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        user = state.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var dbUser = userService.GetByEmail(user.Identity.Name);
            if (dbUser != null)
            {
                perfil = new PerfilModel
                {
                    Email = dbUser.Email,
                    Nombre = dbUser.Nombre, 
                    Apellido = dbUser.Apellido,
                    Telefono = "809-000-0000", // reemplazar con campo real
                    Direccion = "Dirección de ejemplo" // reemplazar con campo real
                };
            }
        }
    }

    // Lógica para guardar el perfil
    private void GuardarCambiosPerfil()
    {
        var ok = userService.UpdatePerfil(perfil.Email, perfil.Nombre, perfil.Apellido, perfil.Telefono, perfil.Direccion);
        if (ok)
        {
            perfilMessage = "Perfil actualizado correctamente ✅";
            perfilMessageCss = "alert alert-success";
        }
        else
        {
            perfilMessage = "No se pudo actualizar el perfil ❌";
            perfilMessageCss = "alert alert-danger";
        }
    }

    // Definición del modelo de Perfil
    public class PerfilModel
    {
        public string Email { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Nombre { get; set; } = ""; 
        public string Apellido { get; set; } = ""; 
    }
}