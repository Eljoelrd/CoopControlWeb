@page "/aportes/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Cajero")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Nuevo Aporte</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

            <RadzenTemplateForm TItem="Aporte" Data="@Aporte" Submit="@AddAporte">
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                    @* Barra superior de acento (Verde Cooperativa) *@
                    <div style="background-color: var(--rz-success); height: 10px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="paid" Style="color: var(--rz-success); font-size: 2rem;" />
                                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Registrar Aporte</RadzenText>
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Seleccione el socio y el monto correspondiente al aporte.</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="1.5rem">
                            
                            @* Selección de Socio *@
                            <RadzenFormField Text="Seleccionar Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenDropDown @bind-Value="Aporte.SocioId" Data="@socios" 
                                               TextProperty="NombreCompleto" ValueProperty="Id" 
                                               AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                               Placeholder="Busque por nombre o apellido..." Name="SocioId" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="SocioId" Text="Debe seleccionar un socio" DefaultValue="0" />

                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Monto (RD$)" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenNumeric @bind-Value="Aporte.Monto" Format="c" Placeholder="0.00" Name="Monto" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Monto" Text="Monto requerido" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Tipo de Aporte" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="Aporte.Tipo" Data="@(new[] { "Ordinario", "Extraordinario" })" Name="Tipo" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Tipo" Text="Seleccione el tipo" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Fecha del Aporte" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenDatePicker @bind-Value="Aporte.Fecha" DateFormat="dd/MM/yyyy" ShowTime="false" />
                            </RadzenFormField>

                            <RadzenFormField Text="Concepto / Detalle" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="Aporte.Concepto" MaxLength="100" />
                            </RadzenFormField>

                            @* Botones *@
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                <RadzenButton Text="Volver" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                              Click="@(() => NavigationManager.NavigateTo("/aportes"))" />
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Procesar Aporte" Icon="check_circle"
                                              ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Large"
                                              Style="border-radius: 25px; padding: 0 2rem;" />
                            </RadzenStack>

                        </RadzenStack>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Aporte Aporte { get; set; } = new() { Fecha = DateTime.Today, SocioId = 0 };
    
    // Lista local de socios con propiedad calculada para el Dropdown
    private List<SocioDisplay> socios = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        socios = await context.Socios
            .Select(s => new SocioDisplay { Id = s.Id, NombreCompleto = s.Nombre + " " + s.Apellido })
            .ToListAsync();
    }

    private async Task AddAporte()
    {
        using var context = DbFactory.CreateDbContext();
        context.Aportes.Add(Aporte);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/aportes");
    }

    // Clase auxiliar para el dropdown
    public class SocioDisplay { 
        public int Id { get; set; } 
        public string NombreCompleto { get; set; } 
    }
}