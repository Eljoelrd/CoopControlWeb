@page "/aportes/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Editar Aporte</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
            
            @if (Aporte == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Localizando transacción...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenTemplateForm TItem="Aporte" Data="@Aporte" Submit="@UpdateAporte">
                    <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                        
                        <div style="background-color: var(--rz-warning); height: 10px; width: 100%;"></div>
                        
                        <div class="rz-p-6 rz-p-md-10">
                            <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="edit" Style="color: var(--rz-warning); font-size: 2rem;" />
                                    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Modificar Aporte</RadzenText>
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">ID de Transacción: #@Aporte.Id</RadzenText>
                            </RadzenStack>

                            <RadzenStack Gap="1.5rem">
                                
                                <RadzenFormField Text="Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDropDown @bind-Value="Aporte.SocioId" Data="@socios" 
                                                   TextProperty="NombreCompleto" ValueProperty="Id" 
                                                   AllowFiltering="true" Name="SocioId" />
                                </RadzenFormField>

                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Monto (RD$)" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenNumeric @bind-Value="Aporte.Monto" Format="c" Name="Monto" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Tipo" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="Aporte.Tipo" Data="@(new[] { "Ordinario", "Extraordinario" })" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenFormField Text="Fecha" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDatePicker @bind-Value="Aporte.Fecha" DateFormat="dd/MM/yyyy" />
                                </RadzenFormField>

                                <RadzenFormField Text="Concepto" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextBox @bind-Value="Aporte.Concepto" />
                                </RadzenFormField>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                    <RadzenButton Text="Cancelar" Icon="cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Click="@(() => NavigationManager.NavigateTo("/aportes"))" />
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Actualizar Datos" Icon="save" 
                                                  ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Large" 
                                                  Style="border-radius: 25px; padding: 0 2rem; color: black;" />
                                </RadzenStack>

                            </RadzenStack>
                        </div>
                    </RadzenCard>
                </RadzenTemplateForm>
            }
            
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [SupplyParameterFromQuery]
    [Parameter] public int Id { get; set; }
    private Aporte? Aporte { get; set; }
    private List<SocioDisplay> socios = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Aporte = await context.Aportes.FirstOrDefaultAsync(m => m.Id == Id);
        socios = await context.Socios
            .Select(s => new SocioDisplay { Id = s.Id, NombreCompleto = s.Nombre + " " + s.Apellido })
            .ToListAsync();

        if (Aporte == null) NavigationManager.NavigateTo("/aportes");
    }

    private async Task UpdateAporte()
    {
        if (Aporte != null)
        {
            using var context = DbFactory.CreateDbContext();
            context.Attach(Aporte).State = EntityState.Modified;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/aportes");
        }
    }

    public class SocioDisplay { 
        public int Id { get; set; } 
        public string NombreCompleto { get; set; } 
    }
}