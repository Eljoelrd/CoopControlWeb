@page "/depositos/create"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Depósito</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="10" SizeLG="8">

            <RadzenTemplateForm TItem="Deposito" Data="@deposito" Submit="@AddDeposito">
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                    <div style="background-color: var(--rz-info); height: 10px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="savings" Style="color: var(--rz-info); font-size: 2rem;" />
                                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Nuevo Depósito</RadzenText>
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Registre el depósito y asócielo a un aporte, préstamo o ahorro libre.</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="1.5rem">

                            @* Fila 1: Socio y Fecha *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Socio" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="deposito.SocioId"
                                                        Data="@socios"
                                                        TextProperty="NombreCompleto"
                                                        ValueProperty="Id"
                                                        AllowFiltering="true"
                                                        Placeholder="Seleccione un socio..."
                                                        Change="@(async (object value) => await OnSocioChanged((int?)value))" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Fecha del Depósito" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDatePicker @bind-Value="deposito.FechaDeposito" DateFormat="dd/MM/yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Fila 2: Tipo de Depósito y Método de Pago *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Tipo de Depósito" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="deposito.TipoDeposito"
                                                        Data="@tiposDeposito"
                                                        Placeholder="Seleccione el tipo..."
                                                        Change="@((object value) => OnTipoChanged())" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Método de Pago" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="deposito.MetodoPago"
                                                        Data="@metodosPago"
                                                        Placeholder="Seleccione método..." />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Si es Ahorro: seleccionar subtipo de ahorro y crear/seleccionar ahorro destino *@
                            @if (deposito.TipoDeposito == "AhorroLibre")
                            {
                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Tipo de Ahorro" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="selectedAhorroTipo"
                                                            Data="@ahorroTipos"
                                                            Placeholder="Seleccione el tipo de ahorro..." />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-mt-1 rz-color-text-secondary">
                                            Seleccione a qué tipo de ahorro se destina el depósito.
                                        </RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                            }

                            @* Fila 3: Monto y Referencia *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Monto" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenNumeric @bind-Value="deposito.Monto"
                                                       Format="c"
                                                       Placeholder="0.00"
                                                       Min="0.01m"
                                                       Step="0.01m" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Referencia Externa" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="deposito.ReferenciaExterna" Placeholder="Ej: TRF-20260309-001" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @* Sección condicional: si es Aporte (se creará uno nuevo automáticamente) *@
                            @if (deposito.TipoDeposito == "Aporte")
                            {
                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-mb-2 rz-color-text-secondary">
                                            Seleccione el tipo de aporte y escriba el concepto que se registrará.
                                        </RadzenText>

                                        <RadzenFormField Text="Tipo de Aporte" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown @bind-Value="selectedAporteTipo"
                                                            Data="@tiposAporte"
                                                            Placeholder="Seleccione tipo de aporte..." />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Concepto" Variant="Variant.Outlined" Style="width: 100%;" Class="rz-mt-3">
                                            <RadzenTextBox @bind-Value="deposito.Observaciones" Placeholder="Escriba el concepto del aporte..." Style="width:100%" />
                                        </RadzenFormField>

                                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-mt-1 rz-color-text-secondary">
                                            <i>Deje vacío si es un depósito general para el socio.</i>
                                        </RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                            }

                            @* Sección condicional: Si es para Préstamo *@
                            @if (deposito.TipoDeposito == "PagoPrestamo")
                            {
                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Préstamo a Pagar" Variant="Variant.Outlined" Style="width: 100%;">
                                            @if (prestamosDelSocio.Any())
                                            {
                                                <RadzenDropDown @bind-Value="deposito.PrestamoId"
                                                                Data="@prestamosDelSocio"
                                                                TextProperty="Descripcion"
                                                                ValueProperty="Id"
                                                                AllowFiltering="true"
                                                                Placeholder="Seleccione un préstamo..." />
                                            }
                                            else
                                            {
                                                <RadzenTextBox Value="No hay préstamos activos para este socio"
                                                               Disabled="true"
                                                               Style="width: 100%" />
                                            }
                                        </RadzenFormField>
                                        @if (!prestamosDelSocio.Any() && deposito.SocioId > 0)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Class="rz-mt-1 rz-color-warning">
                                                <i>⚠️ Este socio no tiene préstamos activos disponibles.</i>
                                            </RadzenText>
                                        }
                                    </RadzenColumn>
                                </RadzenRow>
                            }

                            @* Observaciones y Comprobante *@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Observaciones" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextArea @bind-Value="deposito.Observaciones" Rows="2" Placeholder="Detalles adicionales (se usarán como concepto del aporte)..." />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="URL del Comprobante" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="deposito.ComprobanteUrl" Placeholder="https://..." />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-6">
                                <RadzenButton Text="Volver" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                              Click="@(() => NavigationManager.NavigateTo("/depositos"))" />
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Registrar Depósito" Icon="save"
                                              ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Large"
                                              Style="border-radius: 25px; padding: 0 2rem;" />
                            </RadzenStack>
                        </RadzenStack>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    // ✅ Permite cargar un préstamo específico desde la URL: /depositos/create?prestamoId=5
    [Parameter]
    [SupplyParameterFromQuery(Name = "prestamoId")]
    public int? PrestamoIdFromQuery { get; set; }

    private Deposito deposito = new() { FechaDeposito = DateTime.Today, TipoDeposito = "AhorroLibre" };
    private List<SocioDisplay> socios = new();
    private List<AporteDisplay> aportesDelSocio = new();
    private List<PrestamoDisplay> prestamosDelSocio = new();

    private List<string> tiposDeposito = new() { "Aporte", "PagoPrestamo", "AhorroLibre", "Reembolso" };
    private List<string> metodosPago = new() { "Efectivo", "Transferencia", "Cheque", "Tarjeta" };

    // Ahorros
    private List<string> ahorroTipos = Enum.GetNames(typeof(TipoAhorro)).ToList();
    private string? selectedAhorroTipo
    {
        get => deposito.AhorroTipo;
        set => deposito.AhorroTipo = value;
    }

    // Tipos de aporte para selección en UI
    private List<string> tiposAporte = new() { "Ordinario", "Extraordinario" };
    private string? selectedAporteTipo = "Ordinario";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        // Cargar socios
        socios = await context.Socios
            .OrderBy(s => s.Nombre)
            .ThenBy(s => s.Apellido)
            .Select(s => new SocioDisplay
            {
                Id = s.Id,
                NombreCompleto = $"{s.Nombre} {s.Apellido} - {s.Cedula}"
            })
            .ToListAsync();

        // ✅ Si viene un prestamoId por URL, cargar ese préstamo y su socio automáticamente
        if (PrestamoIdFromQuery.HasValue)
        {
            var prestamo = await context.Prestamos
                .Include(p => p.Socio)
                .FirstOrDefaultAsync(p => p.Id == PrestamoIdFromQuery.Value);

            if (prestamo != null)
            {
                deposito.SocioId = prestamo.SocioId;
                deposito.PrestamoId = prestamo.Id;
                deposito.TipoDeposito = "PagoPrestamo";

                // Cargar préstamos del socio para que el dropdown funcione
                await CargarDatosDelSocio(prestamo.SocioId);
            }
        }
    }

    // Cambiado: ahora recibimos explícitamente el id seleccionado (viene del Radzen Change)
    private async Task OnSocioChanged(int? newSocioId)
    {
        deposito.SocioId = newSocioId ?? 0;

        if (deposito.SocioId > 0)
        {
            await CargarDatosDelSocio(deposito.SocioId);
        }
        else
        {
            aportesDelSocio.Clear();
            prestamosDelSocio.Clear();
            deposito.AporteId = null;
            deposito.PrestamoId = null;
        }
    }

    // ✅ Método extraído para reutilizar la carga de datos
    private async Task CargarDatosDelSocio(int socioId)
    {
        using var context = DbFactory.CreateDbContext();

        // Sólo cargamos préstamos activos para PagoPrestamo (no cargamos aportes en la UI)
        var prestamos = await context.Prestamos
            .Where(p => p.SocioId == socioId && p.Estado != null && p.Estado.ToLower() == "activo")
            .OrderByDescending(p => p.FechaPrestamo)
            .Select(p => new PrestamoDisplay
            {
                Id = p.Id,
                Descripcion = $"#{p.Id} - RD$ {p.Monto:N0} - {p.TipoPrestamo ?? "Personal"}",
                // Calcular saldo pendiente restando pagos registrados (si los hay)
                SaldoPendiente = p.Monto - (p.PrestamoPagos!.Any() ? p.PrestamoPagos.Sum(pp => pp.Monto) : 0m)
            })
            .ToListAsync();

        // Cargar aportes del socio para el dropdown de Aporte (si aplica)
        var aportes = await context.Aportes
            .Where(a => a.SocioId == socioId)
            .OrderByDescending(a => a.Fecha)
            .Select(a => new AporteDisplay
            {
                Id = a.Id,
                ConceptoFecha = $"{a.Concepto} - {a.Fecha:dd/MM/yyyy}",
                Monto = a.Monto,
                Tipo = a.Tipo
            })
            .ToListAsync();

        // Asignar a las listas del componente
        prestamosDelSocio = prestamos;
        aportesDelSocio = aportes;

        // Resetear selecciones si cambió de socio
        if (deposito.SocioId != socioId)
        {
            deposito.AporteId = null;
            deposito.PrestamoId = null;
        }
    }

    private void OnTipoChanged()
    {
        if (deposito.TipoDeposito != "Aporte")
            deposito.AporteId = null;

        if (deposito.TipoDeposito != "PagoPrestamo")
            deposito.PrestamoId = null;
    }

    private async Task AddDeposito()
    {
        if (deposito.TipoDeposito == "PagoPrestamo" && !deposito.PrestamoId.HasValue)
        {
            return;
        }

        try
        {
            using var context = DbFactory.CreateDbContext();

            deposito.FechaCreacion = DateTime.Now;
            deposito.EstaProcesado = true;
            deposito.UsuarioRegistro = "admin";

            // Si es AhorroLibre, buscar o crear Ahorro del socio del tipo seleccionado
            if (deposito.TipoDeposito == "AhorroLibre" && !string.IsNullOrWhiteSpace(selectedAhorroTipo) && deposito.SocioId > 0)
            {
                // Parsear enum
                if (Enum.TryParse<TipoAhorro>(selectedAhorroTipo, out var tipoEnum))
                {
                    var ahorroExistente = await context.Ahorros.FirstOrDefaultAsync(a => a.SocioId == deposito.SocioId && a.Tipo == tipoEnum);
                    if (ahorroExistente != null)
                    {
                        ahorroExistente.Saldo += deposito.Monto;
                        deposito.AhorroId = ahorroExistente.Id; // ✅ ASIGNAR AQUÍ
                    }
                    else
                    {
                        var nuevoAhorro = new Ahorro
                        {
                            SocioId = deposito.SocioId,
                            Tipo = tipoEnum,
                            Saldo = deposito.Monto,
                            FechaCreacion = DateTime.Now
                        };
                        await context.Ahorros.AddAsync(nuevoAhorro);
                        // Guardar primero para obtener el ID y asignarlo al depósito
                        await context.SaveChangesAsync();
                        deposito.AhorroId = nuevoAhorro.Id; // ✅ ASIGNAR AQUÍ
                    }
                }
            }

            // Si es Aporte: crear aporte asociado
            if (deposito.TipoDeposito == "Aporte")
            {
                var aporte = new Aporte
                {
                    SocioId = deposito.SocioId,
                    Fecha = deposito.FechaDeposito,
                    Monto = deposito.Monto,
                    Tipo = selectedAporteTipo ?? "Ordinario",
                    Concepto = deposito.Observaciones
                };
                await context.Aportes.AddAsync(aporte);
                deposito.Aporte = aporte;
            }

            await context.Depositos.AddAsync(deposito);

            if (deposito.TipoDeposito == "PagoPrestamo" && deposito.PrestamoId.HasValue)
            {
                var pago = new PagoPrestamo
                {
                    PrestamoId = deposito.PrestamoId.Value,
                    FechaPago = deposito.FechaDeposito,
                    Monto = deposito.Monto,
                    Metodo = deposito.MetodoPago,
                    Observaciones = $"Pago desde depósito #{deposito.Id}",
                    UsuarioRegistro = deposito.UsuarioRegistro,
                    FechaCreacion = DateTime.Now
                };
                await context.PagoPrestamo.AddAsync(pago);
            }

            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/depositos");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error guardando depósito: {ex}");
            throw;
        }
    }

    // === Clases de visualización ===
    public class SocioDisplay
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
    }

    public class AporteDisplay
    {
        public int Id { get; set; }
        public string ConceptoFecha { get; set; } = string.Empty;
        public decimal Monto { get; set; }
        public string? Tipo { get; set; }
    }

    public class PrestamoDisplay
    {
        public int Id { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal SaldoPendiente { get; set; }
    }
}