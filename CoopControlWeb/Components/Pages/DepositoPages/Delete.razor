@page "/depositos/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using CoopControlWeb.Modelos
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Eliminar Depósito</PageTitle>

<div class="rz-p-0 rz-p-md-12">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

            @if (deposito == null)
            {
                <RadzenCard Class="rz-shadow-10 rz-p-12 text-center">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">Preparando eliminación...</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenTemplateForm TItem="Deposito" Data="@deposito" Submit="@DeleteDeposito">
                    <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">

                        <div style="background-color: var(--rz-danger); height: 10px; width: 100%;"></div>

                        <div class="rz-p-6 rz-p-md-10">
                            <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="delete_forever" Style="color: var(--rz-danger); font-size: 2rem;" />
                                    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Eliminar Depósito</RadzenText>
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-danger">
                                    ¡Atención! Esta acción eliminará el registro del depósito.
                                </RadzenText>
                            </RadzenStack>

                            <div style="background-color: var(--rz-danger-lighter); padding: 1rem; border-radius: 8px;" class="rz-mb-4">
                                <RadzenText TextStyle="TextStyle.Subtitle2">Resumen del depósito a eliminar:</RadzenText>
                                <RadzenStack Gap="0.5rem" Class="rz-mt-2">
                                    <RadzenText TextStyle="TextStyle.Body2"><b>Socio:</b> @deposito.Socio?.Nombre @deposito.Socio?.Apellido</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2"><b>Fecha:</b> @deposito.FechaDeposito.ToString("dd/MM/yyyy")</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2"><b>Monto:</b> @string.Format("{0:C}", deposito.Monto)</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2"><b>Tipo:</b> @deposito.TipoDeposito</RadzenText>
                                </RadzenStack>
                            </div>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenButton Text="Cancelar" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                              Click="@(() => NavigationManager.NavigateTo("/depositos"))" />
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Eliminar Definitivamente" Icon="delete_forever"
                                              ButtonStyle="ButtonStyle.Danger" Style="border-radius: 25px; padding: 0 2rem;" />
                            </RadzenStack>
                        </div>
                    </RadzenCard>
                </RadzenTemplateForm>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Deposito? deposito;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        deposito = await context.Depositos
            .Include(d => d.Socio)
            .Include(d => d.Aporte)
            .Include(d => d.Prestamo)
            .Include(d => d.Ahorro)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (deposito == null)
        {
            NavigationManager.NavigateTo("/depositos");
        }
    }

    private async Task DeleteDeposito()
    {
        if (deposito == null) return;

        try
        {
            using var context = DbFactory.CreateDbContext();

            // Llamada segura al procedimiento almacenado (asegúrese de ejecutar el script SQL en la BD)
            await context.Database.ExecuteSqlInterpolatedAsync($"EXEC dbo.sp_DeleteDepositoAndAhorro @DepositoId = {deposito.Id}");

            // Reconsultar en una nueva instancia de contexto para confirmar la eliminación
            using var checkContext = DbFactory.CreateDbContext();
            var stillExists = await checkContext.Depositos.AnyAsync(d => d.Id == deposito.Id);
            if (stillExists)
            {
                await JS.InvokeVoidAsync("alert", "No se pudo eliminar el depósito. Revise permisos, triggers o el procedimiento almacenado.");
                Console.Error.WriteLine($"sp_DeleteDepositoAndAhorro no eliminó el depósito Id={deposito.Id}");
                return;
            }

            NavigationManager.NavigateTo("/depositos");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al eliminar depósito: {ex.Message}");
            Console.Error.WriteLine(ex);
        }
    }
}
