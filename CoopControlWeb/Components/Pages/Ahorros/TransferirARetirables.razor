@page "/ahorros/transferir-retirable"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Transferir a Ahorro Retirable</PageTitle>

<div class="rz-display-flex rz-align-items-center rz-justify-content-center rz-p-4 rz-p-md-12" style="min-height: 75vh; width: 100%;">
    <RadzenCard class="rz-shadow-10 rz-border-radius-6 rz-p-0" Style="width: 100%; max-width: 800px; overflow: hidden; background-color: var(--rz-panel-background-color);">
        
        @* HEADER CON GRADIENTE ESTILO COOPCONTROL *@
        <div class="rz-p-8 rz-text-align-center" style="background: linear-gradient(135deg, #2f855a 0%, #276749 100%); color: white;">
            <RadzenIcon Icon="swap_horiz" Style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.9;" />
            <RadzenText TextStyle="TextStyle.H4" Style="font-weight: 800; margin: 0; color: white;">Transferencia Interna</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: rgba(255,255,255,0.8); margin-top: 0.5rem;">
                Mover fondos a la cuenta de Ahorros Retirables
            </RadzenText>
        </div>

        <div class="rz-p-8 rz-p-md-12">
            <RadzenStack Gap="2rem">
                @* SELECCIÓN DE SOCIO *@
                <RadzenFormField Text="Seleccione el Socio" Variant="Variant.Outlined" Style="width: 100%;">
                    <Start>
                        <RadzenIcon Icon="person" />
                    </Start>
                    <ChildContent>
                        <RadzenDropDown @bind-Value="selectedSocioId"
                                        Data="@socios"
                                        TextProperty="NombreCompleto"
                                        ValueProperty="Id"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Buscar socio por nombre o cédula..."
                                        Change="@(async (object? v) => await OnSocioChanged((int?)v))" 
                                        Style="width: 100%;" />
                    </ChildContent>
                </RadzenFormField>

                @if (selectedSocioId > 0)
                {
                    <RadzenRow Gap="1.5rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Cuenta de Origen" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start>
                                    <RadzenIcon Icon="account_balance_wallet" />
                                </Start>
                                <ChildContent>
                                    <RadzenDropDown @bind-Value="selectedAhorroOrigenId"
                                                    Data="@ahorrosOrigen"
                                                    TextProperty="Descripcion"
                                                    ValueProperty="Id"
                                                    Placeholder="Seleccione ahorro..." 
                                                    Style="width: 100%;" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Monto a Mover" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start>
                                    <RadzenIcon Icon="attach_money" />
                                </Start>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="monto" Min="@(0.01m)" Format="c" Style="width: 100%;" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenFormField Text="Observaciones (Opcional)" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start>
                            <RadzenIcon Icon="note_add" />
                        </Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="observaciones" Style="width: 100%;" Placeholder="Notas adicionales..." />
                        </ChildContent>
                    </RadzenFormField>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" class="rz-m-0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="error_outline" />
                                <RadzenText TextStyle="TextStyle.Body2">@error</RadzenText>
                            </RadzenStack>
                        </RadzenAlert>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" class="rz-mt-6">
                        <RadzenButton Text="Cancelar" Icon="cancel" ButtonStyle="ButtonStyle.Light" 
                                      Click="@(() => NavigationManager.NavigateTo("/"))" Disabled="@isProcessing"
                                      Style="border-radius: 20px; padding: 0 1.5rem;" />
                        
                        <RadzenButton Text="Confirmar Transferencia" Icon="check_circle" ButtonStyle="ButtonStyle.Primary" 
                                      Click="@(async () => await EjecutarTransferencia())" IsBusy="@isProcessing" 
                                      Disabled="@(selectedAhorroOrigenId == 0 || monto <= 0)" 
                                      Style="border-radius: 20px; padding: 0 2rem; background-color: #2f855a;" />
                    </RadzenStack>
                }
                else
                {
                    @* Estado vacío sugerente para invitar a buscar socio *@
                    <div class="rz-p-12 rz-text-align-center rz-border-radius-4" 
                         style="border: 2px dashed var(--rz-base-300); background-color: var(--rz-base-100); opacity: 0.7;">
                        <RadzenIcon Icon="person_search" Style="font-size: 4rem; color: var(--rz-base-400);" />
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-4 rz-color-text-secondary">
                            Por favor, seleccione un socio para cargar sus cuentas disponibles.
                        </RadzenText>
                    </div>
                }
            </RadzenStack>
        </div>
    </RadzenCard>
</div>

@code {
    private int selectedSocioId;
    private List<SocioDisplay> socios = new();
    private List<AhorroDisplay> ahorrosOrigen = new();
    private int selectedAhorroOrigenId;
    private decimal monto;
    private string? observaciones;
    private string? error;
    private bool isProcessing;

    protected override async Task OnInitializedAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        socios = await ctx.Socios
            .OrderBy(s => s.Nombre)
            .ThenBy(s => s.Apellido)
            .Select(s => new SocioDisplay { Id = s.Id, NombreCompleto = $"{s.Nombre} {s.Apellido} ({s.Cedula})" })
            .ToListAsync();
    }

    private async Task OnSocioChanged(int? id)
    {
        if (!id.HasValue) return;
        selectedSocioId = id.Value;
        await CargarAhorrosOrigen(selectedSocioId);
    }

    private async Task CargarAhorrosOrigen(int socioId)
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        var list = await ctx.Ahorros
            .Where(a => a.SocioId == socioId)
            .OrderByDescending(a => a.FechaCreacion)
            .Select(a => new AhorroDisplay
            {
                Id = a.Id,
                Descripcion = $"{a.Tipo} - Saldo: {a.Saldo:N2}"
            })
            .ToListAsync();

        ahorrosOrigen = list;
        if (ahorrosOrigen.Any())
            selectedAhorroOrigenId = ahorrosOrigen.First().Id;

        await InvokeAsync(StateHasChanged);
    }

    private async Task EjecutarTransferencia()
    {
        if (isProcessing) return;

        error = null;
        if (selectedSocioId == 0 || selectedAhorroOrigenId == 0 || monto <= 0)
        {
            error = "Complete todos los campos correctamente.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        isProcessing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            await using var tx = await ctx.Database.BeginTransactionAsync();

            var ahorroOrigen = await ctx.Ahorros.FirstOrDefaultAsync(a => a.Id == selectedAhorroOrigenId && a.SocioId == selectedSocioId);
            if (ahorroOrigen == null)
            {
                error = "Ahorro origen no encontrado.";
                return;
            }

            if (ahorroOrigen.Saldo < monto)
            {
                error = "Saldo insuficiente en el ahorro origen.";
                return;
            }

            ahorroOrigen.Saldo -= monto;

            var deposito = new Deposito
            {
                SocioId = selectedSocioId,
                FechaDeposito = DateTime.Now,
                Monto = monto,
                TipoDeposito = "Retirables",
                MetodoPago = "TransferenciaInterna",
                Observaciones = observaciones ?? $"Transferencia desde ahorro #{ahorroOrigen.Id}",
                EstaProcesado = true,
                UsuarioRegistro = "admin",
                FechaCreacion = DateTime.Now
            };

            await ctx.Depositos.AddAsync(deposito);
            await ctx.SaveChangesAsync();
            await tx.CommitAsync();

            await InvokeAsync(() => NavigationManager.NavigateTo($"/socios/ahorros?socioId={selectedSocioId}"));
        }
        catch (DbUpdateException dbEx)
        {
            var inner = dbEx.InnerException?.Message ?? dbEx.GetBaseException()?.Message ?? dbEx.Message;
            Console.Error.WriteLine(dbEx);
            error = "Error al transferir: " + inner;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            error = "Error al transferir: " + ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class SocioDisplay
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
    }

    private class AhorroDisplay
    {
        public int Id { get; set; }
        public string Descripcion { get; set; } = string.Empty;
    }
}