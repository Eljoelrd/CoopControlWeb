@page "/socios/estado/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using CoopControlWeb.Modelos
@inject SocioService socioService
@attribute [Authorize(Roles = "Admin")]

<h3>Estado de Cuenta</h3>

@if (estado != null)
{
    <p><strong>Socio:</strong> @estado.NombreCompleto</p>
    <p><strong>Cédula:</strong> @estado.Cedula</p>
    <p><strong>Total Aportes:</strong> RD$ @estado.TotalAportes</p>
    <p><strong>Total Préstamos:</strong> RD$ @estado.TotalPrestamos</p>

    <h5>Aportes</h5>
    <table class="table">
        <thead><tr><th>Fecha</th><th>Monto</th><th>Tipo</th></tr></thead>
        <tbody>
            @foreach (var a in estado.Aportes)
            {
                <tr>
                    <td>@a.Fecha.ToShortDateString()</td>
                    <td>RD$ @a.Monto</td>
                    <td>@a.Tipo</td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Préstamos</h5>
    <table class="table">
        <thead><tr><th>Fecha Préstamo</th><th>Fecha Devolución</th><th>Monto</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var p in estado.Prestamos)
            {
                <tr>
                    <td>@p.FechaPrestamo.ToShortDateString()</td>
                    <td>@(p.FechaDevolucion?.ToShortDateString() ?? "-")</td>
                    <td>RD$ @p.Monto</td>
                    <td>@p.Estado</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Cargando estado de cuenta...</p>
}

@code {
    [Parameter] public int Id { get; set; }
    private EstadoCuentaViewModel? estado;

    protected override void OnInitialized()
    {
        estado = socioService.GetEstadoCuenta(Id);
    }
}
