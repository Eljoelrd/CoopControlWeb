@page "/socios/create"
@rendermode InteractiveServer
@using CoopControlWeb.Modelos
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Socio</PageTitle>

<div class="rz-p-0 rz-p-md-6">
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeLG="10">
            <RadzenTemplateForm TItem="Socios" Data="@socio" Submit="@AddSocios">
                <RadzenCard Class="rz-shadow-10 rz-border-radius-2 rz-p-0">
                    @* Cabecera *@
                    <div style="background-color: var(--rz-primary); height: 8px; width: 100%;"></div>

                    <div class="rz-p-6 rz-p-md-10">
                        <RadzenStack Gap="0.5rem" Class="rz-mb-6">
                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0">Registro de Nuevo Socio</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary">Complete todos los campos para evitar errores de integridad en la base de datos.</RadzenText>
                        </RadzenStack>

                        <RadzenRow Gap="1rem">
                            @* --- SECCIÓN: DATOS PERSONALES --- *@
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Cédula" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenMask Mask="000-0000000-0" CharacterPattern="[0-9]" @bind-Value="socio.Cedula" Name="Cedula" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="socio.Nombre" Name="Nombre" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Apellido" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="socio.Apellido" Name="Apellido" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Fecha de Nacimiento" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDatePicker @bind-Value="socio.FechaNacimiento" DateFormat="dd/MM/yyyy" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            @* --- SECCIÓN: DATOS DE CONTACTO Y ESTADO --- *@
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenMask Mask="(000) 000-0000" CharacterPattern="[0-9]" @bind-Value="socio.Telefono" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="socio.Email" />
                                    </RadzenFormField>

                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Sexo" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenDropDown @bind-Value="socio.Sexo" Data="@(new[] { "Masculino", "Femenino" })" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Tipo Sangre" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenDropDown @bind-Value="socio.TipoSangre" Data="@(new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenFormField Text="Estado Civil" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenDropDown @bind-Value="socio.EstadoCivil" Data="@(new[] { "Soltero(a)", "Casado(a)", "Divorciado(a)", "Viudo(a)", "Unión Libre" })" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            @* --- SECCIÓN: DIRECCIÓN Y OTROS --- *@
                            <RadzenColumn Size="12">
                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Nacionalidad" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="socio.Nacionalidad" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Fecha de Ingreso" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDatePicker @bind-Value="socio.FechaIngreso" DateFormat="dd/MM/yyyy" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenFormField Text="Dirección Completa" Variant="Variant.Outlined" Class="rz-mt-4" Style="width: 100%;">
                                    <RadzenTextArea @bind-Value="socio.Direccion" Rows="2" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        @* Botones *@
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mt-8">
                            <RadzenButton Text="Cancelar" Icon="cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                          Click="@(() => NavigationManager.NavigateTo("/socios"))" />
                            <RadzenButton ButtonType="ButtonType.Submit" Text="Registrar Socio" Icon="check_circle"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" />
                        </RadzenStack>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private Socios socio { get; set; } = new()
    {
        FechaNacimiento = DateTime.Today.AddYears(-18),
        FechaIngreso = DateTime.Today,
        Nacionalidad = "Dominicana" // Valor por defecto útil
    };

    private async Task AddSocios()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            context.Socios.Add(socio);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/socios");
        }
        catch (Exception ex)
        {
            // Aquí se puede agregar un RadzenNotification para mostrar el error
            Console.WriteLine(ex.Message);
        }
    }
}